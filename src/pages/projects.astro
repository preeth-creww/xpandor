---

<BaseLayout
	title="Fitout Projects & Turnkey Retail Execution | Xpandor"
	description="From empty shell to open trading doors. Browse our verified retail fit-out projects archive across South India, managed with strict BOQ ownership, bespoke joinery, MEP engineering, and inspected handover."
	image="/images/kushals/kushals-01-facade-night.jpeg"
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">DISCIPLINE 02</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">TURNKEY FIT-OUT &amp; EXECUTION ARCHIVE</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">CIVIL • MEP • MILLWORK • 21 VERIFIED PLATES</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Fitout Projects &amp; Turnkey Execution</span>
					</div>

					<h1 class="page-title">
						From empty shell to <br class="hidden-sm" />
						<span class="text-gradient-brass">open trading doors.</span>
					</h1>

					<p class="page-subhead">
						You found the space. We make it a high-performing store. Xpandor manages retail fit-outs from architectural CAD drawings and itemized BOQs through civil execution, bespoke joinery, MEP services coordination, and inspected handover — backed by real, verified physical stores on the ground.
					</p>

					<div class="hero-actions">
						<button type="button" class="btn btn-gold" data-open-modal>
							<span>SUBMIT YOUR DETAILED BRIEF ↗</span>
						</button>
						<a href="#archive" class="btn btn-outline">
							<span>Explore Photo Archive ({plates.length} Plates) ↓</span>
						</a>
						<a href="#process" class="btn btn-outline hidden-sm">
							<span>Fit-Out Lifecycle ↓</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Projects Photo Archive Section -->
	<section id="archive" class="section archive-section">
		<div class="container">
			<div class="section-header">
				<div class="section-title-wrap">
					<span class="eyebrow">Physical Store Execution</span>
					<h2 class="section-title">Verified Fitout Projects.</h2>
					<p class="section-desc">
						Real storefronts, custom millwork, display vitrines, civil finishes, and trading spaces executed across South India.
					</p>
				</div>

				<!-- Category Filters -->
				<div class="filter-bar" role="tablist" aria-label="Project filter tabs">
					<button type="button" class="filter-btn active" data-filter="all">
						<span>All Plates ({plates.length})</span>
					</button>
					<button type="button" class="filter-btn" data-filter="kushals">
						<span>Kushal's Flagship (18)</span>
					</button>
					<button type="button" class="filter-btn" data-filter="other">
						<span>Other Commercial (3)</span>
					</button>
				</div>
			</div>

			<!-- Specimen Plates Grid -->
			<div class="plates-grid" id="plates-grid">
				{plates.map((p, idx) => (
					<div 
						class="specimen-plate architectural-frame" 
						data-category={p.category}
						data-index={idx}
					>
						<div class="plate-visual">
							<img 
								src={p.image} 
								alt={`${p.brand} - ${p.title}`} 
								loading="lazy" 
								width="800" 
								height="500" 
								class="plate-img" 
							/>
							<span class="plate-tag">{p.plate}</span>
							<button 
								type="button" 
								class="plate-zoom-btn" 
								aria-label={`View ${p.brand} ${p.title} full screen`}
								data-lightbox-trigger={idx}
							>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="15 3 21 3 21 9"></polyline>
									<polyline points="9 21 3 21 3 15"></polyline>
									<line x1="21" y1="3" x2="14" y2="10"></line>
									<line x1="3" y1="21" x2="10" y2="14"></line>
								</svg>
							</button>
						</div>

						<div class="plate-caption">
							<div class="plate-brand-row">
								<span class="plate-brand">{p.brand}</span>
								<span class="plate-id">{p.plate}</span>
							</div>
							<h3 class="plate-title">{p.title}</h3>
							<p class="plate-subtitle">{p.subtitle}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Process Lifecycle Section -->
	<section id="process" class="section process-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Project Progression</span>
				<h2 class="section-title">The fit-out lifecycle.</h2>
				<p class="section-desc">
					Our internal project management coordinates every trade under a single contract with regular milestone reporting and site coordination.
				</p>
			</div>

			<div class="process-grid">
				<div class="proc-card architectural-frame">
					<span class="proc-step">01</span>
					<h3 class="proc-title">Site Survey &amp; As-Built</h3>
					<p class="proc-desc">Laser-accurate physical dimensions, MEP shaft mapping, structural beam clearances, floor flatness, and landlord fit-out guidelines.</p>
				</div>
				<div class="proc-card architectural-frame">
					<span class="proc-step">02</span>
					<h3 class="proc-title">Design Translation</h3>
					<p class="proc-desc">Translating brand concepts into buildable CAD sets, joinery shop drawings, lighting layouts, and site schematic elevations.</p>
				</div>
				<div class="proc-card architectural-frame">
					<span class="proc-step">03</span>
					<h3 class="proc-title">Constructible BOQ Detailing</h3>
					<p class="proc-desc">Itemized Bill of Quantities with verified material specifications, transparent line items, and scope alignment before work begins.</p>
				</div>
				<div class="proc-card architectural-frame">
					<span class="proc-step">04</span>
					<h3 class="proc-title">Managed Execution</h3>
					<p class="proc-desc">Civil masonry, drywalls, flooring installation, electrical cabling, HVAC balancing, and specialized high-CRI retail accent lighting.</p>
				</div>
				<div class="proc-card architectural-frame">
					<span class="proc-step">05</span>
					<h3 class="proc-title">Bespoke Millwork</h3>
					<p class="proc-desc">Off-site factory fabrication of custom display counters, cash desks, wall vitrines, security displays, and floating island pods.</p>
				</div>
				<div class="proc-card architectural-frame">
					<span class="proc-step">06</span>
					<h3 class="proc-title">QA/QC &amp; Handover</h3>
					<p class="proc-desc">Line-by-line inspection of joinery reveals, paint flatness, electrical loads, snag list resolution, and ready-to-trade site handover.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Technical Trade Depth Capabilities -->
	<section class="section capabilities-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Technical Trade Depth</span>
				<h2 class="section-title">Engineered for retail footfall &amp; durability.</h2>
				<p class="section-desc">
					We build physical spaces designed to withstand thousands of daily customer touches without peeling laminate, sagging shelving, or lighting failure.
				</p>
			</div>

			<div class="grid-3">
				<!-- Card 1: Retail Interior Solutions -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
						</div>
						<span class="trade-tag">SPATIAL</span>
					</div>
					<h3 class="card-title">Retail Interior Solutions</h3>
					<p class="card-text">
						Customer circulation zoning, high-density display fixtures, cashier POS pods, fitting rooms, and brand zones engineered for maximum sales per square foot.
					</p>
				</div>

				<!-- Card 2: Custom Joinery & Millwork -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" x2="16" y1="13" y2="13"></line><line x1="8" x2="16" y1="17" y2="17"></line></svg>
						</div>
						<span class="trade-tag">MILLWORK</span>
					</div>
					<h3 class="card-title">Custom Joinery &amp; Millwork</h3>
					<p class="card-text">
						Bespoke display vitrines with security hardware, floating island counters, marble-clad cash desks, and modular wall panelling fabricated to millimeter tolerances.
					</p>
				</div>

				<!-- Card 3: MEP & Services Coordination -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
						</div>
						<span class="trade-tag">ENGINEERING</span>
					</div>
					<h3 class="card-title">Services &amp; MEP Coordination</h3>
					<p class="card-text">
						Electrical load distribution, retail accent track lighting, HVAC airflow balancing, and statutory fire compliance coordinated by site engineers.
					</p>
				</div>

				<!-- Card 4: Architectural Detailing -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="22" x2="18" y1="12" y2="12"></line><line x1="6" x2="2" y1="12" y2="12"></line><line x1="12" x2="12" y1="6" y2="2"></line><line x1="12" x2="12" y1="22" y2="18"></line></svg>
						</div>
						<span class="trade-tag">FINISHES</span>
					</div>
					<h3 class="card-title">Architectural Detailing</h3>
					<p class="card-text">
						The details that set flagship stores apart: shadow gaps, precision reveals, layered cove ceilings, concealed ambient lighting, and seamless floor transitions.
					</p>
				</div>

				<!-- Card 5: Line-by-Line QA/QC -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
						</div>
						<span class="trade-tag">AUDIT</span>
					</div>
					<h3 class="card-title">Line-by-Line QA/QC</h3>
					<p class="card-text">
						Finishes checked against specification line by line. Alignment, surface flatness, paint consistency, and joinery reveals are inspected before client walkthroughs.
					</p>
				</div>

				<!-- Card 6: Zero Operational Leakage -->
				<div class="card-trade architectural-frame">
					<div class="trade-header">
						<div class="arch-icon">
							<svg width="24" height="24" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m9 12 2 2 4-4"></path></svg>
						</div>
						<span class="trade-tag">GOVERNANCE</span>
					</div>
					<h3 class="card-title">Zero Operational Leakage</h3>
					<p class="card-text">
						Single-point accountability under one master contract. You never manage multiple subcontractors or arbitrate trade disputes. Transparent schedule tracking.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA & Group Company Section -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Execute With Rigor</span>
				<h2 class="cta-title">Planning a store fit-out in South India?</h2>
				<p class="cta-desc">
					Share your store format, square footage, architectural drawings, or target launch date. We will prepare an operational plan, itemized BOQ, and turnkey timeline.
				</p>
				<div class="cta-actions">
					<button type="button" class="btn btn-gold" data-open-modal>
						<span>SUBMIT YOUR DETAILED BRIEF ↗</span>
					</button>
					<a 
						href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20a%20store%20fit-out%20project%20with%20Xpandor.`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline"
					>
						<span>DISCUSS YOUR PLANS WITH US ↗</span>
					</a>
				</div>

				<div class="cta-group-callout">
					<p class="cta-group-text">
						Fit-out execution delivered through our group company, <strong>AV Engineering &amp; Interiors</strong>.
						<a href={AV_INTERIORS_URL} target="_blank" rel="noopener noreferrer" class="group-callout-link">
							View more on our fitout projects here ↗
						</a>
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Lightbox Modal for High-Resolution Inspection -->
	<div class="lightbox-modal" id="lightbox-modal" aria-hidden="true" role="dialog" aria-label="Photo Inspector">
		<div class="lightbox-backdrop" id="lightbox-backdrop"></div>
		<div class="lightbox-content">
			<button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close photo inspector">&times;</button>
			<div class="lightbox-figure">
				<img id="lightbox-img" src="" alt="" />
				<div class="lightbox-meta">
					<span class="lightbox-tag" id="lightbox-tag"></span>
					<span class="lightbox-title" id="lightbox-title"></span>
					<span class="lightbox-sub" id="lightbox-sub"></span>
				</div>
			</div>
			<div class="lightbox-nav">
				<button type="button" class="lightbox-btn" id="lightbox-prev" aria-label="Previous photo">← PREV</button>
				<span class="lightbox-counter" id="lightbox-counter"></span>
				<button type="button" class="lightbox-btn" id="lightbox-next" aria-label="Next photo">NEXT →</button>
			</div>
		</div>
	</div>
</BaseLayout>

<script is:inline define:vars={{ plates }}>
	// Filter functionality
	const filterBtns = document.querySelectorAll('.filter-btn');
	const plateCards = document.querySelectorAll('.specimen-plate');

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			filterBtns.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');

			const filter = btn.getAttribute('data-filter');
			plateCards.forEach((card) => {
				const cat = card.getAttribute('data-category');
				if (filter === 'all' || cat === filter) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		});
	});

	// Lightbox functionality
	const modal = document.getElementById('lightbox-modal');
	const backdrop = document.getElementById('lightbox-backdrop');
	const closeBtn = document.getElementById('lightbox-close');
	const imgEl = document.getElementById('lightbox-img');
	const tagEl = document.getElementById('lightbox-tag');
	const titleEl = document.getElementById('lightbox-title');
	const subEl = document.getElementById('lightbox-sub');
	const counterEl = document.getElementById('lightbox-counter');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');

	let currentIndex = 0;

	function openLightbox(idx) {
		currentIndex = idx;
		renderLightbox();
		modal?.classList.add('is-open');
		modal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function closeLightbox() {
		modal?.classList.remove('is-open');
		modal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	function renderLightbox() {
		const item = plates[currentIndex];
		if (!item) return;
		imgEl.src = item.image;
		imgEl.alt = `${item.brand} - ${item.title}`;
		tagEl.textContent = `${item.plate} • ${item.brand}`;
		titleEl.textContent = item.title;
		subEl.textContent = item.subtitle;
		counterEl.textContent = `${currentIndex + 1} of ${plates.length}`;
	}

	function nextImage() {
		currentIndex = (currentIndex + 1) % plates.length;
		renderLightbox();
	}

	function prevImage() {
		currentIndex = (currentIndex - 1 + plates.length) % plates.length;
		renderLightbox();
	}

	document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
		trigger.addEventListener('click', (e) => {
			e.stopPropagation();
			const idx = parseInt(trigger.getAttribute('data-lightbox-trigger') || '0', 10);
			openLightbox(idx);
		});
	});

	// Also clicking on plate visual opens lightbox
	document.querySelectorAll('.plate-visual').forEach((vis) => {
		vis.addEventListener('click', () => {
			const parent = vis.closest('.specimen-plate');
			const idx = parseInt(parent?.getAttribute('data-index') || '0', 10);
			openLightbox(idx);
		});
	});

	closeBtn?.addEventListener('click', closeLightbox);
	backdrop?.addEventListener('click', closeLightbox);
	nextBtn?.addEventListener('click', nextImage);
	prevBtn?.addEventListener('click', prevImage);

	window.addEventListener('keydown', (e) => {
		if (!modal?.classList.contains('is-open')) return;
		if (e.key === 'Escape') closeLightbox();
		if (e.key === 'ArrowRight') nextImage();
		if (e.key === 'ArrowLeft') prevImage();
	});
</script>

