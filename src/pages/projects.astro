---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Retail Fit-Outs & Turnkey Projects | Xpandor"
	description="From empty shell to opening day. Xpandor manages retail fit-outs with strict BOQ ownership, custom joinery, civil, electrical, and line-by-line QA/QC."
>
	<!-- Hero Section -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-content">
				<span class="eyebrow">02 — BUILD / PROJECTS</span>
				<h1 class="page-title">From empty shell to opening day.</h1>
				<p class="page-subhead">
					You found the space. We'll make it a store. Xpandor manages retail fit-outs from technical drawings and BOQ ownership through procurement, execution, quality control, and inspected handover.
				</p>
				<div class="hero-actions">
					<a 
						href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20retail%20fit-out%20project%20with%20Xpandor.`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-gold"
					>
						<span>Discuss Your Fit-Out on WhatsApp ↗</span>
					</a>
					<a href="#process" class="btn btn-outline">
						<span>Explore Execution Process</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Process Lifecycle -->
	<section id="process" class="section process-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Project Lifecycle</span>
				<h2 class="section-title">The fit-out progression.</h2>
				<p class="section-desc">
					Our internal project management coordinates every trade under a single contract with transparent weekly milestones.
				</p>
			</div>

			<div class="process-grid">
				<div class="proc-card">
					<span class="proc-step">01</span>
					<h3 class="proc-title">Site Survey & As-Built</h3>
					<p class="proc-desc">Laser-accurate physical dimensions, MEP shaft mapping, structural beam clearances, and landlord guidelines.</p>
				</div>
				<div class="proc-card">
					<span class="proc-step">02</span>
					<h3 class="proc-title">Design Translation</h3>
					<p class="proc-desc">Adapting brand concept drawings into detailed technical CAD drawings, joinery shop drawings, and fixture elevations.</p>
				</div>
				<div class="proc-card">
					<span class="proc-step">03</span>
					<h3 class="proc-title">BOQ Ownership</h3>
					<p class="proc-desc">Itemized Bill of Quantities with clear material specifications, fixed line-item pricing, and protected contingencies.</p>
				</div>
				<div class="proc-card">
					<span class="proc-step">04</span>
					<h3 class="proc-title">Managed Execution</h3>
					<p class="proc-desc">Civil, partition walls, flooring, electrical cabling, HVAC ducting coordination, and specialized display lighting.</p>
				</div>
				<div class="proc-card">
					<span class="proc-step">05</span>
					<h3 class="proc-title">Bespoke Millwork</h3>
					<p class="proc-desc">Off-site factory fabrication of custom display counters, cashier desks, wall panelling, vitrines, and island kiosks.</p>
				</div>
				<div class="proc-card">
					<span class="proc-step">06</span>
					<h3 class="proc-title">QA/QC & Handover</h3>
					<p class="proc-desc">Line-by-line inspection of joinery, shadow gaps, illumination levels, snag list clearance, and trading handover.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Capabilities (from AV Engineering benchmark) -->
	<section class="section capabilities-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Trade Depth</span>
				<h2 class="section-title">Engineered for retail footfall & durability.</h2>
				<p class="section-desc">
					We build spaces designed to handle thousands of daily customer touches without peeling laminate, sagging shelving, or lighting failure.
				</p>
			</div>

			<div class="grid-3">
				<div class="card-glass">
					<span class="cap-icon">📐</span>
					<h3 class="card-title">Retail Interior Solutions</h3>
					<p class="card-text">
						Customer circulation zoning, high-density display shelving, cashier POS pods, fitting rooms, and brand zones engineered for maximum sales-per-square-foot.
					</p>
				</div>
				<div class="card-glass">
					<span class="cap-icon">🪚</span>
					<h3 class="card-title">Custom Joinery & Millwork</h3>
					<p class="card-text">
						Bespoke display vitrines with security hardware, floating island counters, marble-clad cash desks, and modular wall panelling fabricated to precise millimeter site tolerances.
					</p>
				</div>
				<div class="card-glass">
					<span class="cap-icon">⚙️</span>
					<h3 class="card-title">Services & MEP Coordination</h3>
					<p class="card-text">
						Electrical load distribution, retail accent track lighting, HVAC airflow balancing, and fire compliance coordination managed by qualified site engineers.
					</p>
				</div>
				<div class="card-glass">
					<span class="cap-icon">✨</span>
					<h3 class="card-title">Architectural Detailing</h3>
					<p class="card-text">
						The details that set flagship stores apart: shadow gaps, precision reveals, layered cove ceilings, concealed ambient lighting, and seamless floor transitions.
					</p>
				</div>
				<div class="card-glass">
					<span class="cap-icon">🛡️</span>
					<h3 class="card-title">Line-by-Line QA/QC</h3>
					<p class="card-text">
						Finishes checked against specification line by line. Alignment, surface flatness, paint consistency, and joinery gaps are inspected before the client ever walks the site.
					</p>
				</div>
				<div class="card-glass">
					<span class="cap-icon">🤝</span>
					<h3 class="card-title">Zero Operational Leaks</h3>
					<p class="card-text">
						Single-point accountability. You don't manage multiple subcontractors on WhatsApp. Xpandor provides milestone photo updates and transparent schedule reports.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Project Visual Proof Gallery -->
	<section class="section gallery-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Real Fit-Outs</span>
				<h2 class="section-title">Executed retail projects.</h2>
				<p class="section-desc">
					A sample of high-street flagships, mall showrooms, and transit concourse stores delivered by our project execution team.
				</p>
			</div>

			<div class="fitout-grid">
				<!-- Project 1: Kushal's -->
				<div class="fitout-card large-fitout">
					<img src="/images/kushals.jpeg" alt="Kushal's standalone flagship store fit-out" loading="lazy" width="800" height="500" />
					<div class="fitout-content">
						<span class="f-eyebrow">High Street Flagship</span>
						<h3 class="f-title">Kushal's Fashion & Silver Jewellery</h3>
						<p class="f-desc">Complete store fit-out, illuminated wave facade, internal lighting design, vitrines & store staffing.</p>
						<span class="f-tag">Turnkey Store Handover</span>
					</div>
				</div>

				<!-- Project 2: Luxury Watch Showroom -->
				<div class="fitout-card">
					<img src="/images/img-001.jpg" alt="Luxury watch mall showroom" loading="lazy" width="600" height="400" />
					<div class="fitout-content">
						<span class="f-eyebrow">Mall Atrium</span>
						<h3 class="f-title">Luxury Timepiece Showroom</h3>
						<p class="f-desc">Rado, Tissot, Guess multi-brand boutique with premium marble flooring and security glass display vitrines.</p>
					</div>
				</div>

				<!-- Project 3: Toy Shire -->
				<div class="fitout-card">
					<img src="/images/img-000.jpg" alt="Toy Shire mall store" loading="lazy" width="600" height="400" />
					<div class="fitout-content">
						<span class="f-eyebrow">Specialty Retail</span>
						<h3 class="f-title">Toy Shire Mall Store</h3>
						<p class="f-desc">Color-matched custom display joinery, thematic cloud cove lighting, and 3D illuminated storefront channel letters.</p>
					</div>
				</div>

				<!-- Project 4: House of Elixir -->
				<div class="fitout-card">
					<img src="/images/img-002.jpg" alt="House of Elixir concourse store" loading="lazy" width="600" height="400" />
					<div class="fitout-content">
						<span class="f-eyebrow">Airport Concourse</span>
						<h3 class="f-title">House of Elixir</h3>
						<p class="f-desc">High-gloss black and gold display joinery, overhead acoustic baffles, and integrated security display counters.</p>
					</div>
				</div>

				<!-- Project 5: Pravasi -->
				<div class="fitout-card">
					<img src="/images/img-021.jpg" alt="Pravasi artisanal store" loading="lazy" width="600" height="400" />
					<div class="fitout-content">
						<span class="f-eyebrow">Lifestyle & Craft</span>
						<h3 class="f-title">Pravasi Artisanal Store</h3>
						<p class="f-desc">Custom arched wall niches, decorative ceiling millwork, hanging brass signage, and patterned vitrified floor inlay.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner mx-auto">
				<span class="eyebrow">Execute With Confidence</span>
				<h2 class="cta-title">Planning a store fit-out in South India?</h2>
				<p class="cta-desc">
					Send us your architectural drawings, BOQ, or site floorplan for an immediate scope evaluation and milestone schedule.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20store%20fit-out%20project%20with%20Xpandor.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold btn-large"
				>
					<span>Connect with Preetham on WhatsApp ↗</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 5rem 0 3.5rem;
		border-bottom: 1px solid var(--border-subtle);
		background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
	}

	.hero-content {
		max-width: 820px;
	}

	.page-title {
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.25rem;
	}

	.page-subhead {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Process Grid */
	.process-section {
		background: #06080E;
		border-bottom: 1px solid var(--border-subtle);
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 860px) {
		.process-grid {
			grid-template-columns: 1fr;
		}
	}

	.proc-card {
		background: var(--bg-surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		padding: 2rem;
		transition: all 0.25s ease;
	}

	.proc-card:hover {
		border-color: var(--border-gold);
		transform: translateY(-2px);
	}

	.proc-step {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent-gold);
		display: block;
		margin-bottom: 0.75rem;
	}

	.proc-title {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
	}

	.proc-desc {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* Grid 3 */
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.grid-3 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid-3 {
			grid-template-columns: 1fr;
		}
	}

	.cap-icon {
		font-size: 1.75rem;
		display: block;
		margin-bottom: 1rem;
	}

	.card-title {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
	}

	.card-text {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* Fitout Grid */
	.fitout-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	@media (max-width: 860px) {
		.fitout-grid {
			grid-template-columns: 1fr;
		}
	}

	.large-fitout {
		grid-column: 1 / -1;
	}

	.fitout-card {
		background: var(--bg-surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		overflow: hidden;
		transition: all 0.25s ease;
		display: flex;
		flex-direction: column;
	}

	.fitout-card:hover {
		border-color: var(--border-gold);
		transform: translateY(-2px);
	}

	.fitout-card img {
		width: 100%;
		height: auto;
		max-height: 420px;
		object-fit: cover;
	}

	.fitout-content {
		padding: 1.75rem;
	}

	.f-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-gold);
		display: block;
		margin-bottom: 0.4rem;
	}

	.f-title {
		font-size: 1.35rem;
		font-weight: 700;
		margin: 0 0 0.6rem;
	}

	.f-desc {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0 0 1rem;
	}

	.f-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--accent-gold);
		background: var(--accent-gold-subtle);
		border: 1px solid var(--border-gold);
		padding: 0.25rem 0.6rem;
		border-radius: var(--radius-sm);
	}

	.cta-banner {
		background: radial-gradient(circle at center, rgba(212, 175, 55, 0.12) 0%, rgba(8, 10, 16, 0) 70%), var(--bg-surface-card);
		border: 1px solid var(--border-gold);
		border-radius: var(--radius-md);
		padding: 4.5rem 2rem;
		text-align: center;
		max-width: 800px;
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		font-weight: 800;
		margin: 0.75rem 0 1rem;
	}

	.cta-desc {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.btn-large {
		padding: 0.85rem 2rem;
	}

	.text-center {
		text-align: center;
	}

	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}
</style>
