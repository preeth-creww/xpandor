---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Retail Siting & Commercial Lease Acquisition | Xpandor"
	description="We help retail brands identify, evaluate, and secure prime commercial locations across Bengaluru and South India matched to format, catchment, and unit economics."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">DISCIPLINE 01</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">SITING & COMMERCIAL LEASING</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">BENGALURU CATCHMENTS • SOUTH INDIA</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Location Intelligence & Siting</span>
					</div>

					<h1 class="page-title">
						The right location is <br class="hidden-sm" />
						<span class="text-gradient-brass">the first decision.</span>
					</h1>

					<p class="page-subhead">
						We help retail brands identify, evaluate, and secure commercial spaces matched to their store format, target demographics, and unit economics across Bengaluru and South India retail corridors.
					</p>

					<div class="hero-actions">
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20location%20requirement%20for%20our%20retail%20brand.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold"
						>
							<span>Share Your Location Requirement</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
						</a>
						<a href="#shortlist" class="btn btn-outline">
							<span>View Comparative Shortlist Matrix ↓</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Proof Highlight Bar -->
	<section class="section proof-section">
		<div class="container">
			<div class="proof-bar architectural-frame">
				<div class="proof-item">
					<span class="proof-number">2</span>
					<span class="proof-label">Commercial Sites Placed</span>
					<span class="proof-sub">Prime Bengaluru retail locations for GoFix</span>
				</div>
				<div class="proof-sep"></div>
				<div class="proof-item">
					<span class="proof-number">3,500+</span>
					<span class="proof-label">Sq. Ft. Leased</span>
					<span class="proof-sub">Prime high-street & corridor footprint</span>
				</div>
				<div class="proof-sep"></div>
				<div class="proof-item">
					<span class="proof-number">100%</span>
					<span class="proof-label">Direct Landlord Closure</span>
					<span class="proof-sub">Rent-free execution buffers secured</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Section: The 3 Criteria Gates -->
	<section class="section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">The Siting Framework</span>
				<h2 class="section-title">What you define. What we audit.</h2>
				<p class="section-desc">
					Before searching the market, we formalize the commercial and operational parameters that define a viable store for your business model.
				</p>
			</div>

			<div class="grid-3">
				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">01</span>
						<span class="card-code">CATCHMENT</span>
					</div>
					<h3 class="card-title">Micro-Market Demographics</h3>
					<p class="card-text">
						Analysis of consumer spending density, daytime vs. evening footfall, competitor clustering, and high-street anchor driver proximity.
					</p>
					<ul class="spec-checklist">
						<li>Pedestrian count & vehicle visibility</li>
						<li>Competitor trading density</li>
						<li>Neighborhood affluence index</li>
					</ul>
				</div>

				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">02</span>
						<span class="card-code">PHYSICAL</span>
					</div>
					<h3 class="card-title">Store Format & MEP Feasibility</h3>
					<p class="card-text">
						Minimum frontage width, floor-to-ceiling clearance, carpet vs. super-built efficiency, power load capacity, and HVAC ducting paths.
					</p>
					<ul class="spec-checklist">
						<li>Frontage ratio & glass exposure</li>
						<li>Floor load & structural columns</li>
						<li>Electrical sanction & generator backup</li>
					</ul>
				</div>

				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">03</span>
						<span class="card-code">ECONOMICS</span>
					</div>
					<h3 class="card-title">Commercial Unit Economics</h3>
					<p class="card-text">
						Base rent ceiling, rent-to-projected-revenue ratio, security deposit terms, common area maintenance (CAM), and rent-free fit-out periods.
					</p>
					<ul class="spec-checklist">
						<li>Rent-free fit-out period (45–75 days)</li>
						<li>Lease tenure & escalation caps</li>
						<li>Title verification & landlord clearance</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Section: We Don't Send Listings (The Shortlist Matrix) -->
	<section id="shortlist" class="section matrix-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Institutional Siting vs. Brokerage</span>
				<h2 class="section-title">We don't send listings. We build a comparative shortlist.</h2>
				<p class="section-desc">
					Brokers flood your inbox with PDF brochures. Xpandor filters properties against your unit economics and formats before presenting an audited comparative shortlist.
				</p>
			</div>

			<div class="table-frame architectural-frame">
				<table class="shortlist-table">
					<thead>
						<tr>
							<th>EVALUATION FACTOR</th>
							<th>PROPERTY A — HIGH STREET</th>
							<th>PROPERTY B — RETAIL MALL</th>
							<th>PROPERTY C — TRANSIT CONCOURSE</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="factor-cell">Usable Carpet Area</td>
							<td>1,850 sqft (88% efficiency)</td>
							<td>1,600 sqft (68% efficiency)</td>
							<td>1,200 sqft (92% efficiency)</td>
						</tr>
						<tr>
							<td class="factor-cell">Frontage & Visibility</td>
							<td><span class="status-tag status-rec">HIGH</span> 35 ft prominent road-facing</td>
							<td><span class="status-tag">MED</span> 22 ft corridor-facing</td>
							<td><span class="status-tag status-rec">HIGH</span> 28 ft corner glass</td>
						</tr>
						<tr>
							<td class="factor-cell">Dedicated Parking</td>
							<td>4 dedicated bays + valet easement</td>
							<td>Common mall parking (400+ bays)</td>
							<td>Basement transit drop-off</td>
						</tr>
						<tr>
							<td class="factor-cell">Target Catchment Fit</td>
							<td>A+ Affluent residential & café crowd</td>
							<td>A Weekend shopping & family dwell</td>
							<td>A High daily commuter footfall</td>
						</tr>
						<tr>
							<td class="factor-cell">Fit-Out Grace Period</td>
							<td>60 days rent-free negotiated</td>
							<td>45 days rent-free standard</td>
							<td>30 days rent-free</td>
						</tr>
						<tr>
							<td class="factor-cell">Xpandor Recommendation</td>
							<td class="eval-rec"><strong>Recommended for Flagship</strong> (high street presence, sustainable rent ratio)</td>
							<td>Viable for secondary mall unit</td>
							<td>Strong for high-velocity impulse sales</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="table-caption">Sample criteria matrix from an Xpandor client expansion shortlist.</p>
		</div>
	</section>

	<!-- Section: Ground-Level Intelligence & Negotiation -->
	<section class="section intelligence-section">
		<div class="container">
			<div class="intel-frame architectural-frame">
				<div class="intel-text">
					<span class="eyebrow">Supply-Side Ground Network</span>
					<h2 class="section-title">Off-market property intelligence.</h2>
					<p class="intel-lead">
						The highest-performing retail spaces rarely hit public property portals. They are transacted through relationships before the outgoing tenant's lease concludes.
					</p>
					<p class="intel-body">
						Across Bengaluru and South India, Xpandor maintains direct relationships with building owners, institutional developers, commercial landlords, and store managers. This grants our clients access to pre-vacancy retail opportunities with verified ownership and clear title history.
					</p>
					<div class="intel-tags">
						<span class="intel-tag">Direct Landlord Contact</span>
						<span class="intel-tag">Pre-Vacancy Tracking</span>
						<span class="intel-tag">Off-Market Exclusives</span>
						<span class="intel-tag">Clear Title Due Diligence</span>
					</div>
				</div>

				<div class="negotiation-card">
					<div class="n-badge">COMMERCIAL TERMS</div>
					<h3 class="n-title">Commercial Negotiation</h3>
					<p class="n-desc">Once a location is shortlisted, Xpandor structures and negotiates the transaction on your behalf:</p>
					<ul class="n-list">
						<li>
							<strong>Rent-Free Fit-Out Grace:</strong>
							<span>Securing 45–75 days of rent-free execution buffer so you never pay rent before trading.</span>
						</li>
						<li>
							<strong>Escalation Caps:</strong>
							<span>Locking multi-year lease escalations within reasonable retail revenue growth bands.</span>
						</li>
						<li>
							<strong>Deposit Rationalization:</strong>
							<span>Negotiating commercial security deposits down from inflated market demands.</span>
						</li>
						<li>
							<strong>Facade & Rooftop Signage Rights:</strong>
							<span>Securing irrevocable rights for primary facade illumination and street signage.</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Location Commissioning</span>
				<h2 class="cta-title">Looking for retail space in Bengaluru?</h2>
				<p class="cta-desc">
					Share your target micro-market, required square footage, and budget. We will audit commercial availability and prepare your shortlist.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20retail%20location%20search%20with%20Xpandor.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold"
				>
					<span>Discuss Locations with Preetham on WhatsApp</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 4rem 3.5rem;
		max-width: 900px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: clamp(2.3rem, 4.8vw, 3.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Proof Highlight */
	.proof-section {
		padding: 2rem 0;
	}

	.proof-bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto 1fr;
		align-items: center;
		padding: 2rem 3rem;
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
	}

	@media (max-width: 860px) {
		.proof-bar {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 1.75rem 1.5rem;
		}
		.proof-sep {
			display: none;
		}
	}

	.proof-item {
		display: flex;
		flex-direction: column;
	}

	.proof-number {
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: 600;
		color: var(--text-main);
		line-height: 1;
		margin-bottom: 0.4rem;
	}

	.proof-label {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent-gold);
		margin-bottom: 0.2rem;
	}

	.proof-sub {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.proof-sep {
		width: 1px;
		height: 50px;
		background: var(--border-subtle);
	}

	/* Grid 3 Spec Cards */
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	@media (max-width: 900px) {
		.grid-3 {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	.spec-card {
		background: var(--bg-surface);
		padding: 2.5rem 2rem;
		border-radius: var(--radius-xs);
		display: flex;
		flex-direction: column;
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
	}

	.card-num {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.card-code {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--text-subdued);
	}

	.card-title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0 0 0.85rem;
		color: var(--text-main);
	}

	.card-text {
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0 0 1.5rem;
	}

	.spec-checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.82rem;
		color: var(--text-muted);
		border-top: 1px solid var(--border-subtle);
		padding-top: 1.25rem;
	}

	.spec-checklist li::before {
		content: '— ';
		color: var(--accent-gold);
	}

	/* Shortlist Table Frame */
	.matrix-section {
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
		background: #090B10;
	}

	.table-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow-x: auto;
		margin-top: 2.5rem;
	}

	.shortlist-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		text-align: left;
		min-width: 720px;
	}

	.shortlist-table th {
		padding: 1.2rem 1.5rem;
		background: rgba(11, 13, 19, 0.7);
		border-bottom: 1px solid var(--border-subtle);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--accent-gold);
		font-weight: 600;
	}

	.shortlist-table td {
		padding: 1.2rem 1.5rem;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text-muted);
		line-height: 1.55;
	}

	.shortlist-table tr:last-child td {
		border-bottom: none;
	}

	.factor-cell {
		font-weight: 600;
		color: var(--text-main) !important;
		font-family: var(--font-display);
		width: 220px;
	}

	.status-tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		padding: 0.2rem 0.5rem;
		border-radius: 2px;
		background: var(--bg-stone-muted);
		color: var(--text-muted);
		margin-right: 0.35rem;
	}

	.status-rec {
		background: var(--accent-gold-subtle);
		color: var(--accent-gold);
		border: 1px solid var(--border-brass);
	}

	.eval-rec {
		background: rgba(197, 168, 128, 0.05);
		color: var(--text-main) !important;
		border-left: 1px solid var(--border-brass);
	}

	.table-caption {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-subdued);
		margin-top: 1rem;
	}

	/* Intelligence Section */
	.intel-frame {
		display: grid;
		grid-template-columns: 1fr 420px;
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	@media (max-width: 960px) {
		.intel-frame {
			grid-template-columns: 1fr;
		}
	}

	.intel-text {
		padding: 4rem 3.5rem;
	}

	@media (max-width: 768px) {
		.intel-text {
			padding: 2.5rem 1.5rem;
		}
	}

	.intel-lead {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--text-main);
		margin: 1.25rem 0 1rem;
	}

	.intel-body {
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.intel-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.intel-tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		background: rgba(11, 13, 19, 0.7);
		border: 1px solid var(--border-subtle);
		padding: 0.4rem 0.85rem;
		color: var(--accent-gold);
		border-radius: 2px;
	}

	.negotiation-card {
		padding: 3.5rem 2.5rem;
		background: rgba(11, 13, 19, 0.6);
		border-left: 1px solid var(--border-subtle);
		display: flex;
		flex-direction: column;
	}

	@media (max-width: 960px) {
		.negotiation-card {
			border-left: none;
			border-top: 1px solid var(--border-subtle);
			padding: 2.5rem 1.5rem;
		}
	}

	.n-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--accent-gold);
		letter-spacing: 0.14em;
		margin-bottom: 0.75rem;
	}

	.n-title {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.85rem;
		color: var(--text-main);
	}

	.n-desc {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}

	.n-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		font-size: 0.85rem;
		line-height: 1.55;
	}

	.n-list strong {
		display: block;
		color: var(--text-main);
		margin-bottom: 0.2rem;
		font-family: var(--font-display);
	}

	.n-list span {
		color: var(--text-muted);
	}

	/* CTA Banner */
	.cta-banner {
		background: var(--bg-surface);
		padding: 4.5rem 3rem;
		border-radius: var(--radius-xs);
		max-width: 800px;
	}

	@media (max-width: 640px) {
		.cta-banner {
			padding: 2.5rem 1.5rem;
		}
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		line-height: 1.15;
		margin: 0.75rem 0 1rem;
		color: var(--text-main);
	}

	.cta-desc {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto 2.25rem;
	}
</style>
