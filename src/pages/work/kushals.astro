---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../../consts';
---

<BaseLayout
	title="Kushal's Architectural Wave Facade | Xpandor Project Dossier"
	description="Project Dossier: Custom architectural backlit wave facade panels and precision storefront illuminated lettering for Kushal's Fashion & Silver Jewellery."
>
	<!-- Case Study Hero: Architectural Drafting Frame -->
	<section class="case-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<a href="/work" class="back-link">← PROJECT ARCHIVE</a>
						<span class="datum-sep">/</span>
						<span class="datum-tag">DOSSIER BLR-FAC-01</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">FACADE & STOREFRONT ILLUMINATION</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Architectural Facade Execution</span>
					</div>

					<h1 class="case-title">Kushal's Fashion & Silver Jewellery</h1>
					<p class="case-subtitle">
						Custom architectural backlit wave facade and precision illuminated storefront branding delivered for one of South India's premier jewellery brands.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Main Photo Feature: Contained Specimen Frame -->
	<section class="case-image-section">
		<div class="container">
			<div class="case-hero-img-wrap architectural-frame">
				<img 
					src="/images/kushals.jpeg" 
					alt="Kushal's Jewellery storefront with illuminated wave facade" 
					class="case-main-img"
					width="1200"
					height="600"
				/>
				<span class="img-caption-tag">FIG 01. PARAMETRIC BACKLIT WAVE FACADE & STOREFRONT ILLUMINATION</span>
			</div>
		</div>
	</section>

	<!-- Structured Breakdown -->
	<section class="section case-body-section">
		<div class="container">
			<div class="case-grid">
				<!-- Left: Narrative Details -->
				<div class="case-details">
					<div class="detail-block">
						<h2 class="detail-heading">The Requirement</h2>
						<p>
							Kushal's required a distinctive storefront architectural presence that would stand out sharply on the retail streetscape. The brand needed an eye-catching facade solution that expressed elegance, modern design, and exceptional nighttime visibility.
						</p>
					</div>

					<div class="detail-block">
						<h2 class="detail-heading">What Xpandor Delivered</h2>
						<ul class="handled-list">
							<li>
								<strong>Parametric Wave Cladding:</strong>
								<span>Engineered, fabricated, and installed the fluid sculptural wave panels that form the defining visual character of the upper storefront elevation.</span>
							</li>
							<li>
								<strong>Concealed Waterproof Backlighting:</strong>
								<span>Integrated concealed LED illumination arrays behind the wave geometry to create soft, uniform nighttime halo illumination across the entire facade.</span>
							</li>
							<li>
								<strong>Precision 3D Storefront Lettering:</strong>
								<span>Fabricated and mounted high-lumen 3D illuminated channel brand letters engineered for high contrast and durability.</span>
							</li>
						</ul>
					</div>

					<div class="detail-block">
						<h2 class="detail-heading">On-Ground Craftsmanship</h2>
						<p>
							Drawing on deep on-ground experience across architectural signage fabrication, metal forming, and site installation, Xpandor ensured precision alignment of every panel reveal, waterproof electrical routing, and clean architectural finishes.
						</p>
					</div>
				</div>

				<!-- Right: Quick Facts Sidebar -->
				<div class="case-sidebar">
					<div class="sidebar-box architectural-frame">
						<h3 class="sidebar-title">Project Specification</h3>
						<div class="sidebar-fact">
							<span class="fact-label">CLIENT</span>
							<span class="fact-val">Kushal's Fashion Jewellery</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">CATEGORY</span>
							<span class="fact-val">Fashion Jewellery</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">SCOPE</span>
							<span class="fact-val">Backlit Wave Facade • 3D Channel Branding</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">DISCIPLINE</span>
							<span class="fact-val">Storefront & Facades</span>
						</div>

						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20storefront%20facade%20similar%20to%20Kushals.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold btn-sidebar"
						>
							<span>Inquire About Facade Projects</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.case-hero {
		padding: 4.5rem 0 2rem;
	}

	@media (max-width: 768px) {
		.case-hero {
			padding: 2.5rem 0 1.5rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.back-link {
		color: var(--accent-gold);
		font-weight: 600;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.datum-tag {
		color: var(--text-main);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 3.5rem 3rem 3rem;
		max-width: 960px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2rem 1.25rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1rem;
	}

	.case-title {
		font-size: clamp(2.2rem, 4.5vw, 3.4rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.5rem 0 1rem;
		color: var(--text-main);
	}

	.case-subtitle {
		font-size: clamp(1rem, 1.4vw, 1.15rem);
		color: var(--text-muted);
		max-width: 780px;
		line-height: 1.7;
		margin: 0;
	}

	.case-image-section {
		padding: 1rem 0 3rem;
	}

	.case-hero-img-wrap {
		border-radius: var(--radius-xs);
		overflow: hidden;
		position: relative;
		background: #000;
	}

	.case-main-img {
		width: 100%;
		height: auto;
		max-height: 560px;
		object-fit: cover;
		display: block;
	}

	.img-caption-tag {
		position: absolute;
		bottom: 1rem;
		left: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		background: rgba(11, 13, 19, 0.85);
		color: var(--accent-gold);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border-brass);
		backdrop-filter: blur(8px);
		border-radius: 2px;
	}

	.case-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	@media (max-width: 900px) {
		.case-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	.detail-block {
		margin-bottom: 2.5rem;
	}

	.detail-heading {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.85rem;
		color: var(--text-main);
	}

	.detail-block p {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0;
	}

	.handled-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.handled-list li {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.handled-list strong {
		color: var(--text-main);
		font-family: var(--font-display);
	}

	.sidebar-box {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		padding: 2.25rem 2rem;
		position: sticky;
		top: 100px;
	}

	.sidebar-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-gold);
		margin: 0 0 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-subtle);
		font-weight: 700;
	}

	.sidebar-fact {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-bottom: 1rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--border-subtle);
	}

	.sidebar-fact:last-of-type {
		border-bottom: none;
		margin-bottom: 1.5rem;
	}

	.fact-label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		color: var(--text-subdued);
	}

	.fact-val {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-main);
	}

	.btn-sidebar {
		width: 100%;
		font-size: 0.85rem;
		padding: 0.85rem 1rem;
	}
</style>
