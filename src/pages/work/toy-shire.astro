---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../../consts';
---

<BaseLayout
	title="Toy Shire Retail Store & Bilingual Signage | Xpandor Case Study"
	description="Case study: Turnkey mall retail fit-out for Toy Shire. Color-matched display joinery, thematic cove lighting, and 3D illuminated regional channel signage."
>
	<!-- Case Study Hero: Architectural Drafting Frame -->
	<section class="case-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<div class="datum-bar">
					<div class="datum-left">
						<a href="/work" class="back-link">← PROJECT ARCHIVE</a>
						<span class="datum-sep">/</span>
						<span class="datum-tag">DOSSIER BLR-MALL-03</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">MALL CONCOURSE, BENGALURU</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Specialty Retail & Mall Fit-Out</span>
					</div>

					<h1 class="case-title">Toy Shire Retail Storefront</h1>
					<p class="case-subtitle">
						High-energy specialty retail store delivered inside a prime shopping mall concourse. Custom color-matched modular shelving, cloud cove ceiling illumination, and 3D block-lit dual-script storefront signage.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Main Photo Feature: Contained Specimen Frame -->
	<section class="case-image-section">
		<div class="container">
			<div class="case-hero-img-wrap architectural-frame">
				<img 
					src="/images/img-000.jpg" 
					alt="Toy Shire mall store fit-out and signage" 
					class="case-main-img"
					width="1200"
					height="600"
				/>
				<span class="img-caption-tag">FIG 01. MALL CONCOURSE ELEVATION & BILINGUAL CHANNEL SIGNAGE</span>
			</div>
		</div>
	</section>

	<!-- Structured Breakdown -->
	<section class="section case-body-section">
		<div class="container">
			<div class="case-grid">
				<!-- Left: Narrative Details -->
				<div class="case-details">
					<div class="detail-block">
						<h2 class="detail-heading">The Requirement</h2>
						<p>
							Toy Shire required a high-capacity, child-friendly retail environment that maximized shelf-facing product count while maintaining wide, stroller-accessible circulation aisles. The storefront demanded prominent visual magnetism visible across the entire mall concourse.
						</p>
					</div>

					<div class="detail-block">
						<h2 class="detail-heading">The Challenge</h2>
						<p>
							Children's specialty retail experiences heavy physical wear: impacts from carts, heavy merchandise loading, and constant shelf adjustment. Standard commercial joinery degrades quickly. Custom edge-banding and reinforced steel internal bracket systems were required, along with nighttime mall installation covenants.
						</p>
					</div>

					<div class="detail-block">
						<h2 class="detail-heading">What Xpandor Handled</h2>
						<ul class="handled-list">
							<li>
								<strong>Dual-Script Channel Signage:</strong>
								<span>Fabricated 3D front-lit channel letters in English alongside regional Bengali script letters with uniform high-lumen diffusion.</span>
							</li>
							<li>
								<strong>Thematic Cloud Ceiling Coves:</strong>
								<span>Formed custom multi-layer drywall ceiling profiles with concealed ambient blue and daylight LED cove troughs.</span>
							</li>
							<li>
								<strong>Heavy-Duty Display Joinery:</strong>
								<span>Built modular gondola shelving units and mobile wheeled display bins with impact-resistant PVC edge profiles and reinforced brackets.</span>
							</li>
							<li>
								<strong>Low-Height Cashier Pods:</strong>
								<span>Ergonomically engineered dual-tier cashier checkout counter accommodating children and adults.</span>
							</li>
						</ul>
					</div>

					<div class="detail-block">
						<h2 class="detail-heading">Execution & Result</h2>
						<p>
							Delivered 4 days ahead of schedule, passing mall structural, electrical, and fire safety inspections on the first attempt without rework, enabling the brand to commence product merchandizing early.
						</p>
					</div>
				</div>

				<!-- Right: Quick Facts Sidebar -->
				<div class="case-sidebar">
					<div class="sidebar-box architectural-frame">
						<h3 class="sidebar-title">Project Specification</h3>
						<div class="sidebar-fact">
							<span class="fact-label">CLIENT</span>
							<span class="fact-val">Toy Shire</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">CATEGORY</span>
							<span class="fact-val">Specialty Toys & Games</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">FORMAT</span>
							<span class="fact-val">Mall Concourse Retail Unit</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">LOCATION</span>
							<span class="fact-val">Mall Concourse, Bengaluru</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">FOOTPRINT</span>
							<span class="fact-val">1,400 Sq. Ft.</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">HANDOVER</span>
							<span class="fact-val">28 Days (4 Days Ahead of Plan)</span>
						</div>
						<div class="sidebar-fact">
							<span class="fact-label">SCOPE</span>
							<span class="fact-val">Fit-Out • Ceilings • Custom Joinery • Signage</span>
						</div>

						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20mall%20retail%20fit-out%20similar%20to%20Toy%20Shire.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold btn-sidebar"
						>
							<span>Inquire About Mall Fit-Out</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.case-hero {
		padding: 4.5rem 0 2rem;
	}

	@media (max-width: 768px) {
		.case-hero {
			padding: 2.5rem 0 1.5rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.back-link {
		color: var(--accent-gold);
		font-weight: 600;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.datum-tag {
		color: var(--text-main);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 3.5rem 3rem 3rem;
		max-width: 960px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2rem 1.25rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1rem;
	}

	.case-title {
		font-size: clamp(2.2rem, 4.5vw, 3.4rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.5rem 0 1rem;
		color: var(--text-main);
	}

	.case-subtitle {
		font-size: clamp(1rem, 1.4vw, 1.15rem);
		color: var(--text-muted);
		max-width: 780px;
		line-height: 1.7;
		margin: 0;
	}

	.case-image-section {
		padding: 1rem 0 3rem;
	}

	.case-hero-img-wrap {
		border-radius: var(--radius-xs);
		overflow: hidden;
		position: relative;
		background: #000;
	}

	.case-main-img {
		width: 100%;
		height: auto;
		max-height: 560px;
		object-fit: cover;
		display: block;
	}

	.img-caption-tag {
		position: absolute;
		bottom: 1rem;
		left: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		background: rgba(11, 13, 19, 0.85);
		color: var(--accent-gold);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border-brass);
		backdrop-filter: blur(8px);
		border-radius: 2px;
	}

	.case-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	@media (max-width: 900px) {
		.case-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	.detail-block {
		margin-bottom: 2.5rem;
	}

	.detail-heading {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.85rem;
		color: var(--text-main);
	}

	.detail-block p {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0;
	}

	.handled-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.handled-list li {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.handled-list strong {
		color: var(--text-main);
		font-family: var(--font-display);
	}

	.sidebar-box {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		padding: 2.25rem 2rem;
		position: sticky;
		top: 100px;
	}

	.sidebar-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-gold);
		margin: 0 0 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border-subtle);
		font-weight: 700;
	}

	.sidebar-fact {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-bottom: 1rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--border-subtle);
	}

	.sidebar-fact:last-of-type {
		border-bottom: none;
		margin-bottom: 1.5rem;
	}

	.fact-label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		color: var(--text-subdued);
	}

	.fact-val {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-main);
	}

	.btn-sidebar {
		width: 100%;
		font-size: 0.85rem;
		padding: 0.85rem 1rem;
	}
</style>
