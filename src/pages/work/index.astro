---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../../consts';

const caseStudies = [
	{
		client: "Kushal's Fashion & Silver Jewellery",
		code: "BLR-FACADE-01",
		category: "FACADE & FIT-OUT",
		location: "Bengaluru",
		scope: "Backlit Wave Facade • 3D Letters • Interior Fit-Out",
		slug: "/work/kushals",
		image: "/images/kushals.jpeg",
		plate: "PLATE 01",
		highlight: "Storefront execution featuring custom parametric backlit wave facade panels, precision illuminated brand lettering, and retail interior fit-out."
	},
	{
		client: "Timepiece & Horology Showroom",
		code: "BLR-MALL-02",
		category: "LUXURY TIMEPIECES",
		location: "Bengaluru",
		scope: "Fit-Out • Vitrines • Floor Transitions • Display Lighting",
		slug: "/work/luxury-watches",
		image: "/images/img-001.jpg",
		plate: "PLATE 02",
		highlight: "Premium boutique retail environment featuring custom perimeter display vitrines, calibrated accent display lighting, and seamless floor transitions."
	},
	{
		client: "Retail Storefront & Custom Millwork",
		code: "BLR-RETAIL-03",
		category: "SPECIALTY RETAIL",
		location: "Bengaluru",
		scope: "Modular Joinery • Display Shelving • 3D Channel Letters",
		slug: "/work/toy-shire",
		image: "/images/img-000.jpg",
		plate: "PLATE 03",
		highlight: "Precision retail fit-out with color-matched modular display joinery, ceiling cove details, and illuminated storefront signage."
	},
	{
		client: "GoFix Electronics Commercial Siting",
		code: "BLR-SITE-04",
		category: "COMMERCIAL SITING",
		location: "Bengaluru",
		scope: "Micro-Market Siting • Landlord Negotiation • Lease Structuring",
		slug: "/work/gofix",
		image: "/images/img-002.jpg",
		plate: "PLATE 04",
		highlight: "Strategic commercial retail locations identified and secured on favorable commercial terms with rent-free execution grace periods."
	}
];
---

<BaseLayout
	title="Architectural Project Archive & Case Studies | Xpandor"
	description="Explore real retail projects executed by Xpandor across Bengaluru and South India: Kushal's, Luxury Watch Showrooms, Toy Shire, and GoFix."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">PROJECT ARCHIVE</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">VERIFIED RETAIL EXECUTION</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">BENGALURU & SOUTH INDIA</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Project Dossiers</span>
					</div>

					<h1 class="page-title">
						Evidence over <br class="hidden-sm" />
						<span class="text-gradient-brass">marketing promises.</span>
					</h1>

					<p class="page-subhead">
						We measure success by physical stores that open on schedule and trade successfully. Examine the real-world scope, technical specifications, and outcomes from our projects.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Projects Grid: Architectural Specimen Plates -->
	<section class="section">
		<div class="container">
			<div class="plates-grid">
				{caseStudies.map((study) => (
					<div class="specimen-plate architectural-frame">
						<div class="plate-visual">
							<img src={study.image} alt={study.client} loading="lazy" width="800" height="500" class="plate-img" />
							<span class="plate-tag">{study.plate} / {study.category}</span>
						</div>

						<div class="plate-dossier">
							<div class="dossier-header">
								<span class="dossier-code">{study.code}</span>
								<span class="dossier-sector">{study.category}</span>
							</div>

							<h3 class="dossier-title">{study.client}</h3>
							<p class="dossier-summary">{study.highlight}</p>

							<div class="dossier-specs-table">
								<div class="spec-cell">
									<span class="spec-k">LOCATION</span>
									<span class="spec-v">{study.location}</span>
								</div>
								<div class="spec-cell">
									<span class="spec-k">CORE SCOPE</span>
									<span class="spec-v">{study.scope}</span>
								</div>
							</div>

							<a href={study.slug} class="dossier-link">
								<span>Read Complete Case Dossier →</span>
							</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Commission Your Store</span>
				<h2 class="cta-title">Ready to execute your next flagship?</h2>
				<p class="cta-desc">
					Share your store format, square footage, and target launch date. We will prepare an operational plan and turnkey timeline.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I%20reviewed%20your%20project%20dossiers%20and%20would%20like%20to%20discuss%20our%20retail%20expansion.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold"
				>
					<span>Discuss Expansion with Preetham on WhatsApp</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 4rem 3.5rem;
		max-width: 900px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: clamp(2.3rem, 4.8vw, 3.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin: 0;
	}

	/* Plates Grid */
	.plates-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	@media (max-width: 960px) {
		.plates-grid {
			grid-template-columns: 1fr;
		}
	}

	.specimen-plate {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.25s ease;
	}

	.specimen-plate:hover {
		border-color: var(--border-brass);
	}

	.plate-visual {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #000;
	}

	.plate-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.specimen-plate:hover .plate-img {
		transform: scale(1.03);
	}

	.plate-tag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		background: rgba(11, 13, 19, 0.85);
		color: var(--accent-gold);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border-brass);
		backdrop-filter: blur(8px);
		border-radius: 2px;
	}

	.plate-dossier {
		padding: 2.25rem 2rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.dossier-header {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		margin-bottom: 0.75rem;
	}

	.dossier-code {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.dossier-sector {
		color: var(--text-subdued);
		letter-spacing: 0.1em;
	}

	.dossier-title {
		font-size: 1.4rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
		color: var(--text-main);
	}

	.dossier-summary {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0 0 1.5rem;
	}

	.dossier-specs-table {
		display: grid;
		grid-template-columns: 1fr 2.2fr;
		gap: 1rem;
		padding: 1.15rem 1.25rem;
		background: rgba(11, 13, 19, 0.5);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
		margin-bottom: 1.75rem;
	}

	@media (max-width: 560px) {
		.dossier-specs-table {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}

	.spec-cell {
		display: flex;
		flex-direction: column;
	}

	.spec-k {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		color: var(--accent-gold);
		letter-spacing: 0.1em;
		margin-bottom: 0.2rem;
	}

	.spec-v {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-main);
	}

	.dossier-link {
		margin-top: auto;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent-gold);
	}

	.dossier-link:hover {
		text-decoration: underline;
	}

	/* CTA */
	.cta-banner {
		background: var(--bg-surface);
		padding: 4.5rem 3rem;
		border-radius: var(--radius-xs);
		max-width: 800px;
	}

	@media (max-width: 640px) {
		.cta-banner {
			padding: 2.5rem 1.5rem;
		}
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		line-height: 1.15;
		margin: 0.75rem 0 1rem;
		color: var(--text-main);
	}

	.cta-desc {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto 2.25rem;
	}
</style>
