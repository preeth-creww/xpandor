---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../../consts';

const projects = [
	{
		brand: "Kushal's",
		image: "/images/kushals.jpeg",
		plate: "PLATE 01"
	},
	{
		brand: "Toy Shire",
		image: "/images/img-000.jpg",
		plate: "PLATE 02"
	},
	{
		brand: "Luxury Watches",
		image: "/images/img-001.jpg",
		plate: "PLATE 03"
	},
	{
		brand: "Commercial Concourse",
		image: "/images/img-002.jpg",
		plate: "PLATE 04"
	}
];
---

<BaseLayout
	title="Selected Projects & Storefront Execution | Xpandor"
	description="Selected retail storefronts and commercial interiors executed by Xpandor across South India."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">PORTFOLIO</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">PHYSICAL RETAIL SPACES</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">BENGALURU & SOUTH INDIA</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Project Archive</span>
					</div>

					<h1 class="page-title">
						Executed physical <br class="hidden-sm" />
						<span class="text-gradient-brass">retail spaces.</span>
					</h1>

					<p class="page-subhead">
						Real storefronts and commercial retail environments executed on the ground.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Projects Grid: Architectural Specimen Plates -->
	<section class="section">
		<div class="container">
			<div class="plates-grid">
				{projects.map((project) => (
					<div class="specimen-plate architectural-frame">
						<div class="plate-visual">
							<img src={project.image} alt={project.brand} loading="lazy" width="800" height="500" class="plate-img" />
							<span class="plate-tag">{project.plate}</span>
						</div>

						<div class="plate-caption">
							<h3 class="plate-title">{project.brand}</h3>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Commission Your Store</span>
				<h2 class="cta-title">Ready to execute your next store?</h2>
				<p class="cta-desc">
					Share your store format, square footage, and target launch date. We will prepare an operational plan and turnkey timeline.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I%20reviewed%20your%20projects%20and%20would%20like%20to%20discuss%20our%20retail%20expansion.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold"
				>
					<span>Discuss Expansion with Preetham on WhatsApp</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 3.5rem 2.5rem;
		max-width: 800px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1rem;
	}

	.page-title {
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin: 0;
	}

	/* Plates Grid */
	.plates-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	@media (max-width: 768px) {
		.plates-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	.specimen-plate {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.25s ease;
	}

	.specimen-plate:hover {
		border-color: var(--border-brass);
	}

	.plate-visual {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #000;
	}

	.plate-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.specimen-plate:hover .plate-img {
		transform: scale(1.02);
	}

	.plate-tag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		background: rgba(11, 13, 19, 0.85);
		color: var(--accent-gold);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border-brass);
		backdrop-filter: blur(8px);
		border-radius: 2px;
	}

	.plate-caption {
		padding: 1.5rem 1.75rem;
		background: var(--bg-surface);
		border-top: 1px solid var(--border-subtle);
	}

	.plate-title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0;
		color: var(--text-main);
		letter-spacing: -0.01em;
	}

	/* CTA */
	.cta-banner {
		background: var(--bg-surface);
		padding: 4.5rem 3rem;
		border-radius: var(--radius-xs);
		max-width: 800px;
	}

	@media (max-width: 640px) {
		.cta-banner {
			padding: 2.5rem 1.5rem;
		}
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		line-height: 1.15;
		margin: 0.75rem 0 1rem;
		color: var(--text-main);
	}

	.cta-desc {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto 2.25rem;
	}
</style>
