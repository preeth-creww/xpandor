---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Store Opening Staffing & Retail Recruitment | Xpandor"
	description="A store isn't ready when construction ends. It's ready when the team is ready. Xpandor delivers store opening staffing for expanding retail brands in South India."
>
	<!-- Hero Section -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-content">
				<span class="eyebrow">04 — STAFF / STORE OPENING STAFFING</span>
				<h1 class="page-title">A store isn't ready when construction ends.<br />It's ready when the team is ready.</h1>
				<p class="page-subhead">
					We don't operate as a generic resume broker. We build and deploy complete store teams—from store managers to front-of-house sales associates—synchronized with your fit-out handover date.
				</p>
				<div class="hero-actions">
					<a 
						href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20store%20staffing%20for%20our%20retail%20expansion.`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-gold"
					>
						<span>Discuss Store Staffing on WhatsApp ↗</span>
					</a>
					<a href="#roles" class="btn btn-outline">
						<span>Explore Retail Roles</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Proof Highlight: Kushal's -->
	<section class="section proof-highlight-section">
		<div class="container">
			<div class="proof-bar">
				<div class="proof-item">
					<span class="proof-number">100%</span>
					<span class="proof-text">Store-Ready Teams on Day One</span>
				</div>
				<div class="proof-sep"></div>
				<div class="proof-item">
					<span class="proof-number">KUSHAL'S</span>
					<span class="proof-text">Complete Retail Store Teams Recruited</span>
				</div>
				<div class="proof-sep"></div>
				<div class="proof-item">
					<span class="proof-number">6 Weeks</span>
					<span class="proof-text">Target Hiring & Onboarding Cycle</span>
				</div>
			</div>
		</div>
	</section>

	<!-- The Staffing Timeline -->
	<section class="section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Synchronized Hiring</span>
				<h2 class="section-title">The store opening staffing lifecycle.</h2>
				<p class="section-desc">
					We initiate recruitment six weeks before fit-out completion so your staff is hired, trained, and on-site when the keys are handed over.
				</p>
			</div>

			<div class="timeline-row">
				<div class="time-card">
					<span class="time-week">Week 1 – 2</span>
					<h3 class="time-title">Manpower Planning & Profiling</h3>
					<p class="time-desc">Defining store headcount, salary benchmarks, shift rosters, and customer service profiles tailored to your brand.</p>
				</div>
				<div class="time-card">
					<span class="time-week">Week 3 – 4</span>
					<h3 class="time-title">Sourcing & In-Person Screening</h3>
					<p class="time-desc">Filtering candidates through our verified retail talent network, screening for punctuality, language, and sales acumen.</p>
				</div>
				<div class="time-card">
					<span class="time-week">Week 5</span>
					<h3 class="time-title">Selection & Offer Rollout</h3>
					<p class="time-desc">Client final round interviews, offer letter coordination, background checks, and joining confirmation.</p>
				</div>
				<div class="time-card">
					<span class="time-week">Week 6</span>
					<h3 class="time-title">Store Launch Readiness</h3>
					<p class="time-desc">On-site merchandising orientation, POS system training, dry run transactions, and grand opening day presence.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Roles We Fill -->
	<section id="roles" class="section roles-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Front & Back of House</span>
				<h2 class="section-title">Retail roles we recruit and deploy.</h2>
				<p class="section-desc">
					Specialized retail talent across fashion, jewelry, luxury watches, furniture, and specialty consumer brands.
				</p>
			</div>

			<div class="grid-3">
				<div class="card-glass">
					<span class="role-icon">👔</span>
					<h3 class="card-title">Store Managers & Team Leads</h3>
					<p class="card-text">
						Experienced retail leaders responsible for P&L, stock reconciliation, daily shift management, customer dispute resolution, and sales targets.
					</p>
				</div>
				<div class="card-glass">
					<span class="role-icon">💎</span>
					<h3 class="card-title">Senior Sales Consultants</h3>
					<p class="card-text">
						High-ticket consultative sales professionals trained in luxury goods, jewelry, watches, apparel styling, and customer rapport.
					</p>
				</div>
				<div class="card-glass">
					<span class="role-icon">🖥️</span>
					<h3 class="card-title">Cashiers & POS Operators</h3>
					<p class="card-text">
						Detail-oriented cashiering staff proficient in retail ERPs, card machine batch settlements, invoice generation, and billing compliance.
					</p>
				</div>
				<div class="card-glass">
					<span class="role-icon">📦</span>
					<h3 class="card-title">Inventory & Stock Keepers</h3>
					<p class="card-text">
						Back-of-house inventory specialists managing inwards goods, barcode scanning, stockroom organization, and theft prevention.
					</p>
				</div>
				<div class="card-glass">
					<span class="role-icon">👗</span>
					<h3 class="card-title">Visual Merchandisers</h3>
					<p class="card-text">
						On-floor display specialists who maintain mannequin styling, brand display guidelines, window rotation, and lighting alignment.
					</p>
				</div>
				<div class="card-glass">
					<span class="role-icon">🛡️</span>
					<h3 class="card-title">Store Security & Front Greeters</h3>
					<p class="card-text">
						Polite, alert security personnel and front-of-house greeters trained in customer welcome and loss prevention.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner mx-auto">
				<span class="eyebrow">Staff Your Next Store</span>
				<h2 class="cta-title">Opening a store in Bengaluru soon?</h2>
				<p class="cta-desc">
					Tell us your store location, opening date, and required headcount. We'll present a workforce plan and verified candidate pipeline.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20store%20staffing%20requirements%20with%20Xpandor.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold btn-large"
				>
					<span>Connect with Preetham on WhatsApp ↗</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 5rem 0 3.5rem;
		border-bottom: 1px solid var(--border-subtle);
		background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
	}

	.hero-content {
		max-width: 820px;
	}

	.page-title {
		font-size: clamp(2.2rem, 5vw, 3.6rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.25rem;
	}

	.page-subhead {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Proof Highlight */
	.proof-highlight-section {
		padding: 2rem 0;
		background: #06080E;
		border-bottom: 1px solid var(--border-subtle);
	}

	.proof-bar {
		display: flex;
		align-items: center;
		justify-content: space-around;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.proof-item {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.proof-number {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--accent-gold);
		line-height: 1;
		font-family: var(--font-mono);
	}

	.proof-text {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-main);
		max-width: 200px;
		line-height: 1.35;
	}

	.proof-sep {
		width: 1px;
		height: 40px;
		background: var(--border-subtle);
	}

	@media (max-width: 768px) {
		.proof-sep {
			display: none;
		}
		.proof-bar {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* Timeline Row */
	.timeline-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.timeline-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 550px) {
		.timeline-row {
			grid-template-columns: 1fr;
		}
	}

	.time-card {
		background: var(--bg-surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		padding: 2rem 1.5rem;
		transition: all 0.25s ease;
	}

	.time-card:hover {
		border-color: var(--border-gold);
		transform: translateY(-2px);
	}

	.time-week {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent-gold);
		display: block;
		margin-bottom: 0.75rem;
	}

	.time-title {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.6rem;
	}

	.time-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
	}

	/* Roles Section */
	.roles-section {
		background: #06080E;
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
	}

	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.grid-3 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid-3 {
			grid-template-columns: 1fr;
		}
	}

	.role-icon {
		font-size: 1.75rem;
		display: block;
		margin-bottom: 0.85rem;
	}

	.card-title {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
	}

	.card-text {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.cta-banner {
		background: radial-gradient(circle at center, rgba(212, 175, 55, 0.12) 0%, rgba(8, 10, 16, 0) 70%), var(--bg-surface-card);
		border: 1px solid var(--border-gold);
		border-radius: var(--radius-md);
		padding: 4.5rem 2rem;
		text-align: center;
		max-width: 800px;
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		font-weight: 800;
		margin: 0.75rem 0 1rem;
	}

	.cta-desc {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.btn-large {
		padding: 0.85rem 2rem;
	}

	.text-center {
		text-align: center;
	}

	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}
</style>
