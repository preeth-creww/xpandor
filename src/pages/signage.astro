---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Retail Signage & Architectural Facades | Xpandor"
	description="Your storefront is part of the store, not a vendor afterthought. Xpandor coordinates architectural facades, 3D channel letters, illuminated signage, and wayfinding."
>
	<!-- Hero Section -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-content">
				<span class="eyebrow">03 — EQUIP / SIGNAGE & FACADES</span>
				<h1 class="page-title">Your storefront is part of the store.</h1>
				<p class="page-subhead">
					Signage shouldn't be a vendor afterthought bolted onto a finished building. Xpandor engineers storefront facades, 3D illuminated channel letters, and wayfinding in lockstep with your interior fit-out.
				</p>
				<div class="hero-actions">
					<a 
						href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20storefront%20signage%20and%20facades%20with%20Xpandor.`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-gold"
					>
						<span>Discuss Signage on WhatsApp ↗</span>
					</a>
					<a href="#showcase" class="btn btn-outline">
						<span>View Storefront Work</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Integrated Signage Matters -->
	<section class="section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">The Integrated Advantage</span>
				<h2 class="section-title">Why buying signage with expansion works better.</h2>
				<p class="section-desc">
					When signage is treated as an isolated purchase, cables dangle through fresh paint, power points are missing, and facade handovers are delayed.
				</p>
			</div>

			<div class="grid-3">
				<div class="card-glass">
					<span class="card-num">01</span>
					<h3 class="card-title">Electrical & MEP Synchronization</h3>
					<p class="card-text">
						Transformer placement, conduit routing, and power load requirements are embedded into the store's primary electrical drawings before walls are closed.
					</p>
				</div>
				<div class="card-glass">
					<span class="card-num">02</span>
					<h3 class="card-title">Structural & Facade Rigor</h3>
					<p class="card-text">
						Sub-frame structural calculations, wind load engineering for high-street facades, and moisture-proof seals prevent structural sagging and electrical shorts.
					</p>
				</div>
				<div class="card-glass">
					<span class="card-num">03</span>
					<h3 class="card-title">Landlord & Mall Compliance</h3>
					<p class="card-text">
						Direct compliance management for mall concourse lumen limits, fire retardant material certifications, and municipal municipal display permissions.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Capabilities -->
	<section class="section capabilities-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Fabrication Scope</span>
				<h2 class="section-title">End-to-end storefront solutions.</h2>
				<p class="section-desc">
					From complex custom architectural wave cladding to precision laser-cut channel letters in regional scripts.
				</p>
			</div>

			<div class="grid-4">
				<div class="card-glass">
					<span class="cap-tag">EXTERIOR</span>
					<h3 class="cap-title">Architectural Facades</h3>
					<p class="cap-desc">Custom wave cladding, backlit acrylic fins, composite paneling, and high-impact structural portals.</p>
				</div>
				<div class="card-glass">
					<span class="cap-tag">ILLUMINATION</span>
					<h3 class="cap-title">3D Channel Lettering</h3>
					<p class="cap-desc">Front-lit, halo-backlit, and edge-lit letters in stainless steel, brass, titanium gold, and cast acrylic.</p>
				</div>
				<div class="card-glass">
					<span class="cap-tag">REGIONAL SCRIPTS</span>
					<h3 class="cap-title">Multilingual Signage</h3>
					<p class="cap-desc">Exact typographic rendering of Kannada, Telugu, Tamil, Bengali, Hindi, and regional scripts for South India compliance.</p>
				</div>
				<div class="card-glass">
					<span class="cap-tag">INTERIOR</span>
					<h3 class="cap-title">Lightboxes & Wayfinding</h3>
					<p class="cap-desc">Fabric LED lightboxes, category overhead indicators, cash counter brand marks, and fitting room signage.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Project Visual Showcase -->
	<section id="showcase" class="section showcase-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Installed Work</span>
				<h2 class="section-title">Storefronts delivered on site.</h2>
				<p class="section-desc">
					Examine the real-world execution of our facade and signage installations.
				</p>
			</div>

			<div class="showcase-grid">
				<!-- Showcase 1: Kushal's -->
				<div class="showcase-card">
					<div class="showcase-img">
						<img src="/images/kushals.jpeg" alt="Kushal's illuminated wave facade" loading="lazy" width="700" height="420" />
					</div>
					<div class="showcase-info">
						<span class="s-client">Kushal's Fashion & Silver Jewellery</span>
						<h3 class="s-title">Architectural Backlit Wave Facade & Dual-Language Signage</h3>
						<p class="s-desc">
							Engineered and installed the iconic undulating vertical warm-white wave elements flanking the main entrance, 3D channel front-lit brand lettering, and regional Telugu script signage.
						</p>
						<div class="s-specs">
							<span>Backlit Wave Fins</span> • <span>Front-lit Channel Letters</span> • <span>Dual-Script Typography</span>
						</div>
					</div>
				</div>

				<!-- Showcase 2: Toy Shire -->
				<div class="showcase-card">
					<div class="showcase-img">
						<img src="/images/img-000.jpg" alt="Toy Shire 3D illuminated signage" loading="lazy" width="700" height="420" />
					</div>
					<div class="showcase-info">
						<span class="s-client">Toy Shire</span>
						<h3 class="s-title">Mall Concourse 3D Block Channel Signage</h3>
						<p class="s-desc">
							Precision routed acrylic channel letters with uniform edge diffusion, floating drop-down portal mounts, and regional script integration for high-density mall footfall.
						</p>
						<div class="s-specs">
							<span>Cast Acrylic Fabrication</span> • <span>High-CRI LED Modules</span> • <span>Concourse Compliance</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner mx-auto">
				<span class="eyebrow">Elevate Your Storefront</span>
				<h2 class="cta-title">Need facade or signage engineering for your next store?</h2>
				<p class="cta-desc">
					Share your brand logo, storefront elevation, and dimensions. We'll provide technical fabrication recommendations and lighting specs.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20a%20storefront%20signage%20requirement%20with%20Xpandor.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold btn-large"
				>
					<span>Connect with Preetham on WhatsApp ↗</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 5rem 0 3.5rem;
		border-bottom: 1px solid var(--border-subtle);
		background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
	}

	.hero-content {
		max-width: 820px;
	}

	.page-title {
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.25rem;
	}

	.page-subhead {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 860px) {
		.grid-3 {
			grid-template-columns: 1fr;
		}
	}

	.card-num {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--accent-gold);
		font-weight: 700;
		display: block;
		margin-bottom: 0.75rem;
	}

	.card-title {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
	}

	.card-text {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* Capabilities Grid 4 */
	.capabilities-section {
		background: #06080E;
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
	}

	.grid-4 {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 1024px) {
		.grid-4 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid-4 {
			grid-template-columns: 1fr;
		}
	}

	.cap-tag {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: var(--accent-gold);
		background: var(--accent-gold-subtle);
		padding: 0.2rem 0.5rem;
		border-radius: 2px;
		display: inline-block;
		margin-bottom: 0.75rem;
	}

	.cap-title {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.cap-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
	}

	/* Showcase */
	.showcase-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
	}

	@media (max-width: 860px) {
		.showcase-grid {
			grid-template-columns: 1fr;
		}
	}

	.showcase-card {
		background: var(--bg-surface-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: all 0.25s ease;
	}

	.showcase-card:hover {
		border-color: var(--border-gold);
		transform: translateY(-2px);
	}

	.showcase-img {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}

	.showcase-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.showcase-card:hover .showcase-img img {
		transform: scale(1.03);
	}

	.showcase-info {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.s-client {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--accent-gold);
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.s-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
	}

	.s-desc {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0 0 1.25rem;
	}

	.s-specs {
		margin-top: auto;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-subdued);
		border-top: 1px solid var(--border-subtle);
		padding-top: 1rem;
	}

	.cta-banner {
		background: radial-gradient(circle at center, rgba(212, 175, 55, 0.12) 0%, rgba(8, 10, 16, 0) 70%), var(--bg-surface-card);
		border: 1px solid var(--border-gold);
		border-radius: var(--radius-md);
		padding: 4.5rem 2rem;
		text-align: center;
		max-width: 800px;
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		font-weight: 800;
		margin: 0.75rem 0 1rem;
	}

	.cta-desc {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.btn-large {
		padding: 0.85rem 2rem;
	}

	.text-center {
		text-align: center;
	}

	.mx-auto {
		margin-left: auto;
		margin-right: auto;
	}
</style>
