---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Retail Signage & Architectural Facades | Xpandor"
	description="Your storefront is the physical face of your brand. Xpandor engineers architectural facades, 3D illuminated channel letters, multilingual scripts, and wayfinding in lockstep with store fit-out."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">DISCIPLINE 03</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">FACADES & STOREFRONT SIGNAGE</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">STRUCTURAL STEEL • 3D LETTERS • BILINGUAL SCRIPTS</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Facade Engineering & Branding</span>
					</div>

					<h1 class="page-title">
						Your storefront is <br class="hidden-sm" />
						<span class="text-gradient-brass">part of the store.</span>
					</h1>

					<p class="page-subhead">
						Signage shouldn't be a fragmented vendor afterthought bolted onto a finished building. Xpandor engineers storefront facades, 3D illuminated channel letters, and regional script compliance in lockstep with your interior fit-out schedule.
					</p>

					<div class="hero-actions">
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20storefront%20signage%20and%20facades%20with%20Xpandor.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold"
						>
							<span>Discuss Signage on WhatsApp</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
						</a>
						<a href="#showcase" class="btn btn-outline">
							<span>View Storefront Projects ↓</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Integrated Signage Matters -->
	<section class="section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">The Integrated Engineering Advantage</span>
				<h2 class="section-title">Why procuring signage with fit-out eliminates rework.</h2>
				<p class="section-desc">
					When signage is treated as an isolated vendor purchase, conduits dangle through fresh paint, electrical capacity is insufficient, and facade handovers lag behind store opening dates.
				</p>
			</div>

			<div class="grid-3">
				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">01</span>
						<span class="card-code">ELECTRICAL</span>
					</div>
					<h3 class="card-title">Electrical & MEP Synchronization</h3>
					<p class="card-text">
						Transformer placement, conduit routing, and power loads are embedded into the store's primary electrical set before partition walls and ceilings are closed.
					</p>
					<ul class="spec-checklist">
						<li>Concealed conduit pathways</li>
						<li>Dedicated transformer access panels</li>
						<li>Surge protection & timer relays</li>
					</ul>
				</div>

				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">02</span>
						<span class="card-code">STRUCTURAL</span>
					</div>
					<h3 class="card-title">Structural & Wind Load Rigor</h3>
					<p class="card-text">
						Engineered sub-frame steel calculations, wind load testing for high-street facades, and industrial weatherproofing seals prevent structural fatigue and short circuits.
					</p>
					<ul class="spec-checklist">
						<li>Galvanized structural sub-frames</li>
						<li>IP67 certified waterproof LEDs</li>
						<li>Monsoon drainage weep channels</li>
					</ul>
				</div>

				<div class="spec-card architectural-frame">
					<div class="card-top">
						<span class="card-num">03</span>
						<span class="card-code">COMPLIANCE</span>
					</div>
					<h3 class="card-title">Mall & Municipal Compliance</h3>
					<p class="card-text">
						Direct compliance management for mall concourse lumen maximums, fire retardant material certifications, and municipal bilingual nameboard regulations.
					</p>
					<ul class="spec-checklist">
						<li>60:40 Kannada language compliance</li>
						<li>Mall lumen & lux limit adherence</li>
						<li>Class-1 fire retardant acrylics</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Fabrication Scope Grid -->
	<section class="section scope-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Fabrication Scope</span>
				<h2 class="section-title">End-to-end storefront solutions.</h2>
				<p class="section-desc">
					From complex parametric architectural wave cladding to precision laser-cut channel letters in regional scripts.
				</p>
			</div>

			<div class="grid-4">
				<div class="scope-card architectural-frame">
					<span class="scope-tag">EXTERIOR</span>
					<h3 class="scope-title">Architectural Facades</h3>
					<p class="scope-desc">Custom wave cladding, backlit acrylic fins, aluminum composite panels (ACP), and structural storefront portals.</p>
				</div>
				<div class="scope-card architectural-frame">
					<span class="scope-tag">ILLUMINATION</span>
					<h3 class="scope-title">3D Channel Lettering</h3>
					<p class="scope-desc">Front-lit, halo-backlit, and edge-lit letterforms fabricated in stainless steel, brushed brass, titanium, and cast acrylic.</p>
				</div>
				<div class="scope-card architectural-frame">
					<span class="scope-tag">REGIONAL SCRIPTS</span>
					<h3 class="scope-title">Multilingual Signage</h3>
					<p class="scope-desc">Exact typographic rendering of Kannada, Telugu, Tamil, Hindi, and regional scripts for South Indian legal compliance.</p>
				</div>
				<div class="scope-card architectural-frame">
					<span class="scope-tag">INTERIOR</span>
					<h3 class="scope-title">In-Store Wayfinding & Lightboxes</h3>
					<p class="scope-desc">Department identifiers, ultra-slim fabric lightboxes, cashier LED branding, and directional wayfinding.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Storefront Showcase Plates -->
	<section id="showcase" class="section showcase-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Storefront Proof</span>
				<h2 class="section-title">Executed facade projects.</h2>
				<p class="section-desc">
					Real storefronts engineered, fabricated, and installed by our facade specialists across commercial street fronts and malls.
				</p>
			</div>

			<div class="plates-grid">
				<!-- Plate 1: Kushal's -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img src="/images/kushals.jpeg" alt="Kushal's" loading="lazy" width="800" height="500" class="plate-img" />
						<span class="plate-tag">PLATE 01</span>
					</div>
					<div class="plate-caption">
						<h3 class="plate-title">Kushal's</h3>
					</div>
				</div>

				<!-- Plate 2: Toy Shire -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img src="/images/img-000.jpg" alt="Toy Shire" loading="lazy" width="800" height="500" class="plate-img" />
						<span class="plate-tag">PLATE 02</span>
					</div>
					<div class="plate-caption">
						<h3 class="plate-title">Toy Shire</h3>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Storefront Specification</span>
				<h2 class="cta-title">Need facade or signage engineering?</h2>
				<p class="cta-desc">
					Send us your brand guidelines, storefront elevation CADs, or site photos for technical fabrication scoping and compliance review.
				</p>
				<a 
					href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20storefront%20signage%20and%20facades%20with%20Xpandor.`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-gold"
				>
					<span>Discuss Signage with Preetham on WhatsApp</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 4rem 3.5rem;
		max-width: 900px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: clamp(2.3rem, 4.8vw, 3.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Grid 3 Spec Cards */
	.grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	@media (max-width: 960px) {
		.grid-3 {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	.spec-card {
		background: var(--bg-surface);
		padding: 2.5rem 2rem;
		border-radius: var(--radius-xs);
		display: flex;
		flex-direction: column;
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
	}

	.card-num {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.card-code {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--text-subdued);
	}

	.card-title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0 0 0.85rem;
		color: var(--text-main);
	}

	.card-text {
		font-size: 0.88rem;
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0 0 1.5rem;
	}

	.spec-checklist {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.82rem;
		color: var(--text-muted);
		border-top: 1px solid var(--border-subtle);
		padding-top: 1.25rem;
	}

	.spec-checklist li::before {
		content: '— ';
		color: var(--accent-gold);
	}

	/* Scope Grid */
	.scope-section {
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
		background: #090B10;
	}

	.grid-4 {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 1024px) {
		.grid-4 {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.grid-4 {
			grid-template-columns: 1fr;
		}
	}

	.scope-card {
		background: var(--bg-surface);
		padding: 2.25rem 1.75rem;
		border-radius: var(--radius-xs);
		display: flex;
		flex-direction: column;
	}

	.scope-tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--accent-gold);
		margin-bottom: 1rem;
	}

	.scope-title {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
		color: var(--text-main);
	}

	.scope-desc {
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0;
	}

	/* Plates Grid */
	.plates-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	@media (max-width: 960px) {
		.plates-grid {
			grid-template-columns: 1fr;
		}
	}

	.specimen-plate {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.25s ease;
	}

	.specimen-plate:hover {
		border-color: var(--border-brass);
	}

	.plate-visual {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #000;
	}

	.plate-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.specimen-plate:hover .plate-img {
		transform: scale(1.03);
	}

	.plate-tag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		background: rgba(11, 13, 19, 0.85);
		color: var(--accent-gold);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border-brass);
		backdrop-filter: blur(8px);
		border-radius: 2px;
	}

	.plate-caption {
		padding: 1.5rem 1.75rem;
		background: var(--bg-surface);
		border-top: 1px solid var(--border-subtle);
	}

	.plate-title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0;
		color: var(--text-main);
		letter-spacing: -0.01em;
	}

	/* CTA */
	.cta-banner {
		background: var(--bg-surface);
		padding: 4.5rem 3rem;
		border-radius: var(--radius-xs);
		max-width: 800px;
	}

	@media (max-width: 640px) {
		.cta-banner {
			padding: 2.5rem 1.5rem;
		}
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		line-height: 1.15;
		margin: 0.75rem 0 1rem;
		color: var(--text-main);
	}

	.cta-desc {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto 2.25rem;
	}
</style>
