---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import TimelineEstimator from '../components/TimelineEstimator.astro';
import { FOUNDER_LINKEDIN, FOUNDER_NAME, FOUNDER_ROLE, WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout 
	title="Xpandor | Retail Expansion Partner — Siting, Fit-Out, Signage & Staffing"
	description="Xpandor takes complete operational ownership behind physical retail growth in South India. We find locations, secure leases, engineer turnkey fit-outs, deliver facades, and recruit opening teams."
>
	<!-- Hero Section: Architectural Drafting Frame (No Photo Required) -->
	<section class="hero-section">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">XPANDOR / SPECIFICATION</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">RETAIL EXPANSION PARTNER</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">BENGALURU HQ • 12.9716° N, 77.5946° E</span>
					</div>
				</div>

				<!-- Hero Centerpiece -->
				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Turnkey Retail Infrastructure</span>
					</div>

					<h1 class="hero-title">
						Expand without the <br class="hidden-sm" />
						<span class="text-gradient-brass">operational chaos.</span>
					</h1>

					<p class="hero-lead">
						Xpandor takes complete operational ownership behind physical retail growth. We find locations, negotiate commercial leases, engineer turnkey fit-outs, fabricate facades, and recruit opening teams — managed under a single master contract.
					</p>

					<div class="hero-actions">
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20our%20retail%20expansion%20plans%20with%20Xpandor.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold"
						>
							<span>SHARE YOUR REQUIREMENTS ↗</span>
						</a>

						<a href="#selected-work" class="btn btn-outline">
							<span>Explore Completed Works ↓</span>
						</a>
					</div>
				</div>

				<!-- Architectural Cinematic Video Centerpiece: The Turnkey Retail Journey -->
				<div class="hero-cinematic-stage">
					<div class="stage-header-bar">
						<div class="stage-tag">
							<span class="stage-dot"></span>
							<span class="stage-title">CINEMATIC SURVEY • PHYSICAL RETAIL EXPANSION SEQUENCE</span>
						</div>
						<div class="stage-meta">
							<span>1080P FULL HD • 30 FPS • PARALLEL ISOMETRIC CAD</span>
						</div>
					</div>

					<div class="stage-viewport">
						<video 
							id="heroVideo"
							class="hero-video"
							autoplay 
							loop 
							muted 
							playsinline 
							poster="/videos/xpandor-journey-poster.jpg"
							title="Xpandor Turnkey Expansion Journey: Siting, Leasing, Fit-Out & Staffing"
						>
							<source src="/videos/xpandor-journey.mp4" type="video/mp4" />
							<source src="/videos/xpandor-journey.webm" type="video/webm" />
							Your browser does not support the video tag.
						</video>

						<div class="stage-controls-overlay">
							<button id="videoToggleBtn" class="video-control-pill" aria-label="Toggle Video Playback">
								<span id="videoControlIcon" class="control-icon">❚❚</span>
								<span id="videoControlText" class="control-text">PAUSE</span>
							</button>
						</div>
					</div>

					<div class="stage-caption-bar">
						<div class="caption-step"><span class="step-num">01</span> Global Scan & Siting</div>
						<div class="caption-sep">→</div>
						<div class="caption-step"><span class="step-num">02</span> CMH Rd Catchment</div>
						<div class="caption-sep">→</div>
						<div class="caption-step"><span class="step-num">03</span> Metro Cluster Audit</div>
						<div class="caption-sep">→</div>
						<div class="caption-step"><span class="step-num">04</span> Turnkey Fit-Out</div>
						<div class="caption-sep">→</div>
						<div class="caption-step"><span class="step-num">05</span> Retail Staffing</div>
					</div>
				</div>

				<!-- Integrated 4-Bay Architectural Ledger -->
				<div class="discipline-ledger">
					<a href="/locations" class="ledger-bay">
						<div class="bay-header">
							<span class="bay-num">01</span>
							<span class="bay-arrow">↗</span>
						</div>
						<h3 class="bay-title">Siting & Catchment</h3>
						<p class="bay-desc">Commercial lease sourcing, footfall feasibility, and lease structuring across key South Indian retail corridors.</p>
					</a>

					<a href="/projects" class="ledger-bay">
						<div class="bay-header">
							<span class="bay-num">02</span>
							<span class="bay-arrow">↗</span>
						</div>
						<h3 class="bay-title">Turnkey Fit-Out</h3>
						<p class="bay-desc">Civil construction, MEP engineering, bespoke joinery, and inspected delivery on committed dates.</p>
					</a>

					<a href="/signage" class="ledger-bay">
						<div class="bay-header">
							<span class="bay-num">03</span>
							<span class="bay-arrow">↗</span>
						</div>
						<h3 class="bay-title">Facades & Signage</h3>
						<p class="bay-desc">Structural steel fabrication, 3D illuminated letters, and compliant bilingual storefront branding.</p>
					</a>

					<a href="/people" class="ledger-bay">
						<div class="bay-header">
							<span class="bay-num">04</span>
							<span class="bay-arrow">↗</span>
						</div>
						<h3 class="bay-title">Retail Staffing</h3>
						<p class="bay-desc">Store leadership and retail associate recruitment, coordinated alongside store fit-out for launch readiness.</p>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 2: Operating Specifications Ledger -->
	<section class="section metrics-section">
		<div class="container">
			<div class="metrics-ledger-frame architectural-frame">
				<div class="metrics-ledger-grid">
					<div class="metric-column">
						<div class="metric-top-datum">
							<span class="datum-spec-id">SPEC 01</span>
							<span class="datum-spec-cat">GOVERNANCE</span>
						</div>
						<div class="metric-val-wrap">
							<span class="metric-num">100</span>
							<span class="metric-unit">%</span>
						</div>
						<h4 class="metric-title">Single Accountability</h4>
						<p class="metric-detail">One expansion partner. One master contract. Direct founder governance without vendor handoffs.</p>
					</div>

					<div class="metric-column">
						<div class="metric-top-datum">
							<span class="datum-spec-id">SPEC 02</span>
							<span class="datum-spec-cat">SCOPE</span>
						</div>
						<div class="metric-val-wrap">
							<span class="metric-num metric-num-text">Turnkey</span>
						</div>
						<h4 class="metric-title">Integrated Delivery</h4>
						<p class="metric-detail">Commercial siting, turnkey interior fit-out, storefront facades, and retail team readiness under one roof.</p>
					</div>

					<div class="metric-column">
						<div class="metric-top-datum">
							<span class="datum-spec-id">SPEC 03</span>
							<span class="datum-spec-cat">NETWORK</span>
						</div>
						<div class="metric-val-wrap">
							<span class="metric-num metric-num-text">South India</span>
						</div>
						<h4 class="metric-title">Regional Footprint</h4>
						<p class="metric-detail">Deep on-ground network across Bengaluru and tier-1/tier-2 South Indian commercial corridors.</p>
					</div>
				</div>

				<div class="brand-lineage">
					<span class="lineage-label">TRUSTED ACROSS REGIONAL & ENTERPRISE RETAIL ROLLOUTS</span>
					<div class="lineage-names">
						<span>KUSHAL'S</span>
						<span class="dot">•</span>
						<span>WOODEN STREET</span>
						<span class="dot">•</span>
						<span>GOFIX</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 3: The Procurement Matrix (The 7-Vendor Problem vs. Turnkey Ownership) -->
	<section class="section matrix-section">
		<div class="container">
			<div class="section-header text-center mx-auto" style="max-width: 780px;">
				<span class="eyebrow">Procurement Reality</span>
				<h2 class="section-title">Opening a store is one physical project.<br />Not seven disconnected vendors.</h2>
				<p class="section-desc mx-auto">
					Traditional retail expansion fractures responsibility across brokers, lawyers, designers, and trades. When a store opening is delayed by four weeks, every vendor blames the next.
				</p>
			</div>

			<div class="matrix-table architectural-frame">
				<div class="matrix-row matrix-header-row">
					<div class="col-phase">EXPANSION PHASE</div>
					<div class="col-trad">CONVENTIONAL FRAGMENTED MODEL</div>
					<div class="col-xpandor">THE XPANDOR TURNKEY PARTNERSHIP</div>
				</div>

				<div class="matrix-row">
					<div class="col-phase">
						<span class="phase-code">01</span>
						<strong>Site Selection</strong>
					</div>
					<div class="col-trad text-muted">
						Local broker shows spaces without evaluating fit-out feasibility, MEP loads, or true civil renovation costs.
					</div>
					<div class="col-xpandor">
						<span class="check-mark">✓</span>
						<strong>Commercial Feasibility Audit:</strong> Every site screened against unit economics, power loads, and build capex before you sign.
					</div>
				</div>

				<div class="matrix-row">
					<div class="col-phase">
						<span class="phase-code">02</span>
						<strong>Lease Negotiation</strong>
					</div>
					<div class="col-trad text-muted">
						Disconnected legal counsel unaware of rent-free fit-out periods required for civil execution.
					</div>
					<div class="col-xpandor">
						<span class="check-mark">✓</span>
						<strong>Turnkey Commercial Structuring:</strong> Rent-free execution buffers, landlord NOCs, and escalation caps locked upfront.
					</div>
				</div>

				<div class="matrix-row">
					<div class="col-phase">
						<span class="phase-code">03</span>
						<strong>Fit-Out & Execution</strong>
					</div>
					<div class="col-trad text-muted">
						Architect drawings fail to align with site MEP reality. Contractor pushes cost variations onto client.
					</div>
					<div class="col-xpandor">
						<span class="check-mark">✓</span>
						<strong>Strict BOQ & Schedule Control:</strong> Single master team coordinating civil, HVAC, electrical, and bespoke joinery with zero markup leakage.
					</div>
				</div>

				<div class="matrix-row">
					<div class="col-phase">
						<span class="phase-code">04</span>
						<strong>Facade & Signage</strong>
					</div>
					<div class="col-trad text-muted">
						Sign vendor shows up on handover day only to realize facade framing was never reinforced.
					</div>
					<div class="col-xpandor">
						<span class="check-mark">✓</span>
						<strong>Synchronized Signage:</strong> Facade engineering built directly into civil schedules. 3D illuminated letters ready 7 days prior.
					</div>
				</div>

				<div class="matrix-row">
					<div class="col-phase">
						<span class="phase-code">05</span>
						<strong>Store Launch</strong>
					</div>
					<div class="col-trad text-muted">
						Staffing agency begins sourcing associates after doors are built. Store sits empty paying rent.
					</div>
					<div class="col-xpandor">
						<span class="check-mark">✓</span>
						<strong>Synchronized Staffing:</strong> Store manager and retail crew recruited and inducted ahead of store handover for day-one readiness.
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 4: The 6-Stage Turnkey Journey -->
	<section id="journey" class="section journey-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Structured Execution</span>
				<h2 class="section-title">The Sequence Is The Product.</h2>
				<p class="section-desc">
					You don't buy fragmented services. You commission one integrated expansion sequence from location discovery to doors open.
				</p>
			</div>

			<JourneyTimeline activeStep={1} />
		</div>
	</section>

	<!-- Section 5: Selected Project Specimen Plates -->
	<section id="selected-work" class="section work-section">
		<div class="container">
			<div class="section-header">
				<div class="header-split">
					<div>
						<span class="eyebrow">Real Physical Execution</span>
						<h2 class="section-title">Executed Projects.</h2>
						<p class="section-desc">
							Selected retail storefronts and commercial interiors delivered across South India.
						</p>
					</div>
					<a href="/work" class="btn btn-outline hidden-sm">
						<span>View All Projects ↗</span>
					</a>
				</div>
			</div>

			<!-- Project Plates Grid -->
			<div class="plates-grid">
				<!-- Plate 01: Kushal's -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img 
							src="/images/kushals.jpeg" 
							alt="Kushal's" 
							loading="lazy" 
							width="800" 
							height="500" 
							class="plate-img"
						/>
						<span class="plate-tag">PLATE 01</span>
					</div>

					<div class="plate-caption">
						<h3 class="plate-title">Kushal's</h3>
					</div>
				</div>

				<!-- Plate 02: Toy Shire -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img 
							src="/images/img-000.jpg" 
							alt="Toy Shire" 
							loading="lazy" 
							width="800" 
							height="500" 
							class="plate-img"
						/>
						<span class="plate-tag">PLATE 02</span>
					</div>

					<div class="plate-caption">
						<h3 class="plate-title">Toy Shire</h3>
					</div>
				</div>

				<!-- Plate 03: Luxury Watches -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img 
							src="/images/img-001.jpg" 
							alt="Luxury Watches" 
							loading="lazy" 
							width="800" 
							height="500" 
							class="plate-img"
						/>
						<span class="plate-tag">PLATE 03</span>
					</div>

					<div class="plate-caption">
						<h3 class="plate-title">Luxury Watches</h3>
					</div>
				</div>

				<!-- Plate 04: Commercial Concourse -->
				<div class="specimen-plate architectural-frame">
					<div class="plate-visual">
						<img 
							src="/images/img-002.jpg" 
							alt="Commercial Concourse" 
							loading="lazy" 
							width="800" 
							height="500" 
							class="plate-img"
						/>
						<span class="plate-tag">PLATE 04</span>
					</div>

					<div class="plate-caption">
						<h3 class="plate-title">Commercial Concourse</h3>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 6: Interactive Store Milestone Specifier -->
	<section class="section estimator-section">
		<div class="container">
			<TimelineEstimator />
		</div>
	</section>

	<!-- Section 7: Founder & Expansion Lead Accountability -->
	<section class="section leadership-section">
		<div class="container">
			<div class="leadership-frame architectural-frame">
				<div class="leadership-body">
					<span class="eyebrow">Direct Principal Accountability</span>
					<h2 class="leadership-title">No junior account managers.<br />One direct line to leadership.</h2>
					<p class="leadership-lead">
						In commercial real estate and physical construction, deals are won on trust and executed on personal accountability. Every Xpandor rollout is overseen directly by senior leadership.
					</p>
					<p class="leadership-text">
						We own commercial negotiations, BOQ verification, site inspections, and handover sign-offs directly. If a contractor falls behind or a landlord pushes an unreasonable clause, you speak directly with the decision-maker who resolves it.
					</p>

					<div class="leadership-highlights">
						<div class="hl-item">
							<span class="hl-dot">▪</span>
							<div>
								<strong>Single Master Contract:</strong> Zero mediation between architects and trades.
							</div>
						</div>
						<div class="hl-item">
							<span class="hl-dot">▪</span>
							<div>
								<strong>Daily Milestone Audits:</strong> Proactive snag resolution before handover dates.
							</div>
						</div>
					</div>
				</div>

				<div class="founder-spec-card">
					<div class="founder-badge">FOUNDER & LEAD</div>
					<div class="founder-monogram">PP</div>
					<h3 class="founder-name">{FOUNDER_NAME}</h3>
					<p class="founder-role">{FOUNDER_ROLE}</p>
					<p class="founder-quote">
						“Retail expansion is an operational sport. Brands don't need another list of vendors; they need someone to own the difficult middle between the strategy deck and open doors.”
					</p>
					
					<div class="founder-contacts">
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20our%20retail%20expansion%20with%20you.`}
							target="_blank" 
							rel="noopener noreferrer" 
							class="btn btn-gold btn-founder"
						>
							<span>DISCUSS YOUR PLANS WITH US ↗</span>
						</a>
						<a 
							href={FOUNDER_LINKEDIN} 
							target="_blank" 
							rel="noopener noreferrer" 
							class="btn btn-outline btn-founder"
						>
							<span>LinkedIn Profile ↗</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 8: Final Strategic Intake -->
	<section class="section intake-section">
		<div class="container">
			<div class="intake-banner architectural-frame">
				<div class="intake-content">
					<span class="eyebrow">Expansion Commissioning</span>
					<h2 class="intake-title">Planning your next retail store in South India?</h2>
					<p class="intake-desc">
						Share your target micro-market, footprint size, or target launch timeline. We will review your brief, evaluate commercial availability, and arrange an on-ground consultation in Bengaluru.
					</p>
					
					<div class="intake-actions">
						<button type="button" class="btn btn-gold" data-open-modal>
							<span>SUBMIT YOUR DETAILED BRIEF ↗</span>
						</button>
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20our%20retail%20expansion%20plans%20with%20Xpandor.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline"
						>
							<span>DISCUSS YOUR PLANS WITH US ↗</span>
						</a>
					</div>
					<p class="intake-notice">Direct principal review • Confidentiality guaranteed • South India focus</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero Section: Architectural Drafting Frame */
	.hero-section {
		padding: 4.5rem 0 3.5rem;
	}

	@media (max-width: 768px) {
		.hero-section {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	/* Top Datum Bar */
	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
			padding: 0.85rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	/* Hero Body */
	.hero-body {
		padding: 4.5rem 3.5rem 4rem;
		max-width: 960px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem 2.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.hero-title {
		font-size: clamp(2.5rem, 5.5vw, 4.4rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.025em;
		margin: 0 0 1.5rem;
		color: var(--text-main);
	}

	.hero-lead {
		font-size: clamp(1.05rem, 1.6vw, 1.22rem);
		line-height: 1.7;
		color: var(--text-muted);
		max-width: 780px;
		margin: 0 0 2.5rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Hero Cinematic Stage */
	.hero-cinematic-stage {
		border-top: 1px solid var(--border-subtle);
		background: #05060A;
		position: relative;
		overflow: hidden;
	}

	.stage-header-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2.5rem;
		background: rgba(11, 14, 20, 0.9);
		border-bottom: 1px solid var(--border-subtle);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	@media (max-width: 768px) {
		.stage-header-bar {
			padding: 0.75rem 1.25rem;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
		}
	}

	.stage-tag {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--accent-gold);
		font-weight: 700;
	}

	.stage-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent-gold);
		box-shadow: 0 0 8px var(--accent-gold);
		animation: stagePulse 2s infinite ease-in-out;
	}

	@keyframes stagePulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.35; transform: scale(0.85); }
	}

	.stage-meta {
		color: var(--text-subdued);
		font-size: 0.7rem;
	}

	.stage-viewport {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #05060A;
		overflow: hidden;
	}

	.hero-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

