<script>
	const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
	const btn = document.getElementById('videoToggleBtn');
	const icon = document.getElementById('videoControlIcon');
	const text = document.getElementById('videoControlText');

	if (video && btn && icon && text) {
		btn.addEventListener('click', () => {
			if (video.paused) {
				video.play();
				icon.textContent = '❚❚';
				text.textContent = 'PAUSE';
			} else {
				video.pause();
				icon.textContent = '▶';
				text.textContent = 'PLAY';
			}
		});
	}
</script>
