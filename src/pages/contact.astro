---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, CONTACT_PHONE, FOUNDER_LINKEDIN, FOUNDER_NAME, FOUNDER_ROLE, WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Commission An Expansion Brief | Xpandor"
	description="Submit your retail store expansion requirement directly to Xpandor leadership. Siting, fit-out execution, facades, and staffing across Bengaluru and South India."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">COMMISSIONING DESK</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">RETAIL EXPANSION INTAKE</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">DIRECT PRINCIPAL REVIEW • BENGALURU HQ</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Direct Principal Intake</span>
					</div>

					<h1 class="page-title">
						Tell us about your <br class="hidden-sm" />
						<span class="text-gradient-brass">expansion requirement.</span>
					</h1>

					<p class="page-subhead">
						Whether you are planning a standalone flagship in Bengaluru or a multi-store South India rollout, submit your parameters below. Every brief is reviewed directly by senior leadership.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="contact-layout">
				<!-- Intake Form (Architectural Spec Sheet Style) -->
				<div class="form-container architectural-frame">
					<div class="form-header">
						<span class="form-badge">SPECIFICATION SHEET</span>
						<h2 class="form-heading">Retail Expansion Brief</h2>
						<p class="form-subtext">
							Fill in your expansion parameters below. This compiles a structured brief sent directly to <strong>{FOUNDER_NAME} ({CONTACT_PHONE})</strong> for immediate review.
						</p>
					</div>

					<form id="contact-expansion-form" class="main-form">
						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-brand">Brand Name *</label>
								<input type="text" id="c-brand" required placeholder="e.g. Kushal's, GoFix, D2C Retailer" />
							</div>
							<div class="form-group">
								<label for="c-contact">Your Name & Role *</label>
								<input type="text" id="c-contact" required placeholder="e.g. Founder, Head of Expansion" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-phone">Phone / WhatsApp Number *</label>
								<input type="tel" id="c-phone" required placeholder="+91 98458 XXXXX" />
							</div>
							<div class="form-group">
								<label for="c-email">Corporate Email</label>
								<input type="email" id="c-email" placeholder="name@brand.com" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-city">Target City / Micro-Markets *</label>
								<input type="text" id="c-city" required placeholder="e.g. Bengaluru (Indiranagar / Whitefield)" />
							</div>
							<div class="form-group">
								<label for="c-sqft">Target Store Size & Count *</label>
								<input type="text" id="c-sqft" required placeholder="e.g. 1 Store, 1,500 – 2,500 sqft" />
							</div>
						</div>

						<div class="form-group">
							<label>Capabilities Required *</label>
							<div class="scope-grid">
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Locations (Find & Lease)" checked />
									<span>01 Siting & Commercial Lease Negotiation</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Projects (Fit-Out & Execution)" checked />
									<span>02 Turnkey Fit-Out & Joinery Execution</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Signage (Storefront & Facade)" checked />
									<span>03 Facade Engineering & 3D Signage</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="People (Store Opening Staffing)" checked />
									<span>04 Store Staffing & Team Induction</span>
								</label>
							</div>
						</div>

						<div class="form-group">
							<label for="c-timeline">Target Opening Timeline</label>
							<select id="c-timeline">
								<option value="Immediate (45–60 days)">Immediate (within 45–60 days)</option>
								<option value="Next Quarter (60–90 days)">Next Quarter (60–90 days)</option>
								<option value="Planning 3–6 months out">Planning 3–6 months out</option>
								<option value="Multi-store South India rollout">Multi-store South India rollout</option>
							</select>
						</div>

						<div class="form-group">
							<label for="c-notes">Additional Siting or Technical Criteria</label>
							<textarea id="c-notes" rows="3" placeholder="Power requirements, ceiling heights, preferred roads, or target budget..."></textarea>
						</div>

						<button type="submit" class="btn btn-gold btn-submit">
							<span>SHARE YOUR REQUIREMENTS ↗</span>
						</button>
					</form>
				</div>

				<!-- Direct Contact Info Dossier -->
				<div class="direct-contact architectural-frame">
					<span class="direct-badge">COMMUNICATION CHANNELS</span>
					<h3 class="direct-title">Direct Leadership Line</h3>
					<p class="direct-sub">
						No call center or unmonitored general inboxes. Direct communication with Xpandor's commercial lead.
					</p>

					<div class="contact-card">
						<div class="contact-person">
							<div class="cp-avatar">PP</div>
							<div>
								<h4 class="cp-name">{FOUNDER_NAME}</h4>
								<p class="cp-role">{FOUNDER_ROLE}</p>
							</div>
						</div>

						<div class="contact-channel">
							<span class="c-label">WHATSAPP / MOBILE</span>
							<a href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20our%20retail%20expansion%20with%20Xpandor.`} target="_blank" rel="noopener noreferrer" class="c-value text-gold">
								{CONTACT_PHONE} ↗
							</a>
						</div>

						<div class="contact-channel">
							<span class="c-label">DIRECT EMAIL</span>
							<a href={`mailto:${CONTACT_EMAIL}`} class="c-value">
								{CONTACT_EMAIL}
							</a>
						</div>

						<div class="contact-channel">
							<span class="c-label">PROFESSIONAL PROFILE</span>
							<a href={FOUNDER_LINKEDIN} target="_blank" rel="noopener noreferrer" class="c-value text-gold">
								Preetham Phirangi on LinkedIn ↗
							</a>
						</div>

						<div class="contact-channel">
							<span class="c-label">HEADQUARTERS</span>
							<p class="c-value text-muted">
								Bengaluru, Karnataka, India<br />
								South India Retail Expansion Desk
							</p>
						</div>
					</div>

					<div class="sla-card">
						<span class="sla-title">COMMISSIONING PROTOCOL</span>
						<ul class="sla-list">
							<li>Same-day brief acknowledgement</li>
							<li>Initial commercial search commitment in the next 72 hours</li>
							<li>Direct consultation with Preetham Phirangi</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const contactForm = document.getElementById('contact-expansion-form');
	if (contactForm) {
		contactForm.addEventListener('submit', (e) => {
			e.preventDefault();
			const brand = (document.getElementById('c-brand') as HTMLInputElement)?.value || '';
			const contact = (document.getElementById('c-contact') as HTMLInputElement)?.value || '';
			const city = (document.getElementById('c-city') as HTMLInputElement)?.value || '';
			const sqft = (document.getElementById('c-sqft') as HTMLInputElement)?.value || '';
			const timeline = (document.getElementById('c-timeline') as HTMLSelectElement)?.value || '';
			const notes = (document.getElementById('c-notes') as HTMLTextAreaElement)?.value || '';

			const checkedBoxes = document.querySelectorAll('input[name="scope_item"]:checked');
			const scopes: string[] = [];
			checkedBoxes.forEach((cb) => scopes.push((cb as HTMLInputElement).value));

			const message = `*XPANDOR RETAIL EXPANSION BRIEF*

• *Brand:* ${brand}
• *Contact:* ${contact}
• *Target Market:* ${city}
• *Store Size:* ${sqft}
• *Scope Needed:* ${scopes.join(', ')}
• *Target Timeline:* ${timeline}
${notes ? `• *Notes:* ${notes}` : ''}

Hi Preetham, we would like to commission an expansion consultation with Xpandor.`;

			const encodedMsg = encodeURIComponent(message);
			const whatsappUrl = `https://wa.me/919845808425?text=${encodedMsg}`;
			window.open(whatsappUrl, '_blank');
		});
	}
</script>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 4rem 3.5rem;
		max-width: 900px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: clamp(2.3rem, 4.8vw, 3.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin: 0;
	}

	/* Contact Layout */
	.contact-layout {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 2.5rem;
		align-items: start;
	}

	@media (max-width: 960px) {
		.contact-layout {
			grid-template-columns: 1fr;
		}
	}

	/* Form */
	.form-container {
		background: var(--bg-surface);
		padding: 3.5rem 3rem;
		border-radius: var(--radius-xs);
	}

	@media (max-width: 640px) {
		.form-container {
			padding: 2rem 1.25rem;
		}
	}

	.form-header {
		margin-bottom: 2.5rem;
	}

	.form-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--accent-gold);
		margin-bottom: 0.5rem;
		display: block;
	}

	.form-heading {
		font-size: 1.8rem;
		font-weight: 600;
		margin: 0 0 0.5rem;
		color: var(--text-main);
	}

	.form-subtext {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}

	.main-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	@media (max-width: 600px) {
		.form-grid-2 {
			grid-template-columns: 1fr;
		}
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.form-group label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--accent-gold);
		text-transform: uppercase;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		background: rgba(11, 13, 19, 0.7);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
		padding: 0.85rem 1rem;
		font-family: var(--font-body);
		font-size: 0.92rem;
		color: var(--text-main);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		border-color: var(--border-brass);
	}

	.scope-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	@media (max-width: 600px) {
		.scope-grid {
			grid-template-columns: 1fr;
		}
	}

	.scope-box {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1rem;
		background: rgba(11, 13, 19, 0.5);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
		cursor: pointer;
		font-size: 0.82rem;
		color: var(--text-muted);
		transition: border-color 0.2s ease;
	}

	.scope-box:hover {
		border-color: var(--border-brass);
	}

	.scope-box input[type="checkbox"] {
		accent-color: var(--accent-gold);
	}

	.btn-submit {
		width: 100%;
		padding: 1rem 2rem;
		font-size: 0.95rem;
		margin-top: 1rem;
	}

	/* Direct Contact */
	.direct-contact {
		background: var(--bg-surface);
		padding: 3rem 2rem;
		border-radius: var(--radius-xs);
		display: flex;
		flex-direction: column;
	}

	.direct-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--accent-gold);
		margin-bottom: 0.5rem;
	}

	.direct-title {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.5rem;
		color: var(--text-main);
	}

	.direct-sub {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0 0 2rem;
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		border-top: 1px solid var(--border-subtle);
		padding-top: 1.75rem;
	}

	.contact-person {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.cp-avatar {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--bg-stone-muted);
		border: 1px solid var(--border-brass);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--accent-gold);
		font-size: 1rem;
	}

	.cp-name {
		font-size: 1.05rem;
		font-weight: 600;
		margin: 0;
		color: var(--text-main);
	}

	.cp-role {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--accent-gold);
		margin: 0;
	}

	.contact-channel {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.c-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-subdued);
		letter-spacing: 0.1em;
	}

	.c-value {
		font-size: 0.88rem;
		color: var(--text-main);
	}

	.sla-card {
		margin-top: 2rem;
		padding: 1.5rem;
		background: rgba(11, 13, 19, 0.5);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
	}

	.sla-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--accent-gold);
		display: block;
		margin-bottom: 0.75rem;
	}

	.sla-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.sla-list li::before {
		content: '— ';
		color: var(--accent-gold);
	}
</style>
