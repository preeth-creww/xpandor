---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, CONTACT_PHONE, FOUNDER_LINKEDIN, FOUNDER_NAME, FOUNDER_ROLE, WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="Tell Us About Your Expansion | Xpandor"
	description="Submit your retail store expansion requirement directly to Xpandor leadership. Location search, fit-out execution, signage, and staffing across Bengaluru and South India."
>
	<!-- Hero Section -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-content">
				<span class="eyebrow">DIRECT INTAKE</span>
				<h1 class="page-title">Tell us about your expansion.</h1>
				<p class="page-subhead">
					Whether you are planning a single flagship store in Bengaluru or a multi-city South India rollout, share your requirements directly with our expansion team.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="contact-layout">
				<!-- Intake Form -->
				<div class="form-container">
					<h2 class="form-heading">Retail Expansion Brief</h2>
					<p class="form-subtext">
						Fill in your expansion parameters below. This will generate a structured brief sent directly to <strong>{FOUNDER_NAME} ({CONTACT_PHONE})</strong> for immediate review.
					</p>

					<form id="contact-expansion-form" class="main-form">
						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-brand">Brand Name *</label>
								<input type="text" id="c-brand" required placeholder="e.g. Kushal's, GoFix, D2C Brand" />
							</div>
							<div class="form-group">
								<label for="c-contact">Your Name & Role *</label>
								<input type="text" id="c-contact" required placeholder="e.g. Founder, Head of Expansion" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-phone">Phone / WhatsApp Number *</label>
								<input type="tel" id="c-phone" required placeholder="+91 98458 XXXXX" />
							</div>
							<div class="form-group">
								<label for="c-email">Corporate Email</label>
								<input type="email" id="c-email" placeholder="name@brand.com" />
							</div>
						</div>

						<div class="form-grid-2">
							<div class="form-group">
								<label for="c-city">Target City / Micro-Markets *</label>
								<input type="text" id="c-city" required placeholder="e.g. Bengaluru (Indiranagar / Whitefield)" />
							</div>
							<div class="form-group">
								<label for="c-sqft">Target Store Size & Count *</label>
								<input type="text" id="c-sqft" required placeholder="e.g. 1 Store, 1,500 – 2,500 sqft" />
							</div>
						</div>

						<div class="form-group">
							<label>What capabilities do you need? (Select all that apply) *</label>
							<div class="scope-grid">
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Locations (Find & Lease)" checked />
									<span>01 Locations (Site Search & Lease Closure)</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Projects (Fit-Out & Execution)" checked />
									<span>02 Projects (End-to-End Retail Fit-out)</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="Signage (Storefront & Facade)" checked />
									<span>03 Signage (Storefront Facades & 3D Letters)</span>
								</label>
								<label class="scope-box">
									<input type="checkbox" name="scope_item" value="People (Store Opening Staffing)" checked />
									<span>04 People (Store Opening Staffing)</span>
								</label>
							</div>
						</div>

						<div class="form-group">
							<label for="c-timeline">Target Opening Timeline</label>
							<select id="c-timeline">
								<option value="Immediate (45–60 days)">Immediate (within 45–60 days)</option>
								<option value="Next Quarter (60–90 days)">Next Quarter (60–90 days)</option>
								<option value="Planning 3–6 months out">Planning 3–6 months out</option>
								<option value="Multi-store South India rollout">Multi-store South India rollout</option>
							</select>
						</div>

						<div class="form-group">
							<label for="c-notes">Additional Context or Specific Siting Criteria</label>
							<textarea id="c-notes" rows="3" placeholder="Preferred street frontage, ceiling height requirements, mall vs high-street preference..."></textarea>
						</div>

						<div class="form-submit-row">
							<button type="submit" class="btn btn-gold btn-form-submit">
								<span>Send Brief via WhatsApp to Preetham ↗</span>
							</button>
							<p class="submit-disclaimer">
								Connects directly to WhatsApp. You will receive an immediate acknowledgment and response from leadership.
							</p>
						</div>
					</form>
				</div>

				<!-- Direct Contact Info Sidebar -->
				<div class="contact-sidebar">
					<div class="card-glass sidebar-card">
						<span class="eyebrow">Direct Contact</span>
						<h3 class="sidebar-heading">Talk to Leadership</h3>
						<p class="sidebar-p">
							We do not use ticketing portals or call center screens. You speak directly with leadership responsible for expansion outcomes.
						</p>

						<div class="contact-item">
							<span class="c-label">Direct WhatsApp / Phone</span>
							<a href={`${WHATSAPP_BASE_URL}?text=Hi%20Preetham,%20I'd%20like%20to%20discuss%20our%20retail%20expansion.`} target="_blank" rel="noopener noreferrer" class="c-val-gold">
								{CONTACT_PHONE} ↗
							</a>
						</div>

						<div class="contact-item">
							<span class="c-label">Official Email</span>
							<a href={`mailto:${CONTACT_EMAIL}`} class="c-val">
								{CONTACT_EMAIL}
							</a>
						</div>

						<div class="contact-item">
							<span class="c-label">Leadership</span>
							<span class="c-val">{FOUNDER_NAME}</span>
							<span class="c-role">{FOUNDER_ROLE}</span>
							<a href={FOUNDER_LINKEDIN} target="_blank" rel="noopener noreferrer" class="c-linkedin">
								View LinkedIn Profile ↗
							</a>
						</div>

						<div class="contact-item">
							<span class="c-label">Primary Operating Hub</span>
							<span class="c-val">Bengaluru, Karnataka, India</span>
							<span class="c-sub">South India Regional Execution</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const contactForm = document.getElementById('contact-expansion-form');

	contactForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const brand = (document.getElementById('c-brand') as HTMLInputElement)?.value || '';
		const contact = (document.getElementById('c-contact') as HTMLInputElement)?.value || '';
		const phone = (document.getElementById('c-phone') as HTMLInputElement)?.value || '';
		const email = (document.getElementById('c-email') as HTMLInputElement)?.value || '';
		const city = (document.getElementById('c-city') as HTMLInputElement)?.value || '';
		const sqft = (document.getElementById('c-sqft') as HTMLInputElement)?.value || '';
		const timeline = (document.getElementById('c-timeline') as HTMLSelectElement)?.value || '';
		const notes = (document.getElementById('c-notes') as HTMLTextAreaElement)?.value || '';

		const scopes: string[] = [];
		contactForm.querySelectorAll('input[name="scope_item"]:checked').forEach((box) => {
			scopes.push((box as HTMLInputElement).value);
		});

		const message = 
`*NEW RETAIL EXPANSION BRIEF — XPANDOR*
• *Brand:* ${brand}
• *Contact Person:* ${contact}
• *Phone/WhatsApp:* ${phone}
• *Email:* ${email || 'Not specified'}
• *Target Location:* ${city}
• *Footprint & Stores:* ${sqft}
• *Scope Needed:* ${scopes.join(' | ')}
• *Target Timeline:* ${timeline}
${notes ? `• *Notes:* ${notes}` : ''}

Hi Preetham, we would like to schedule an expansion consultation with Xpandor.`;

		const whatsappUrl = `https://wa.me/919845808425?text=${encodeURIComponent(message)}`;
		window.open(whatsappUrl, '_blank');
	});
</script>

<style>
	.page-hero {
		padding: 5rem 0 3.5rem;
		border-bottom: 1px solid var(--border-subtle);
		background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
	}

	.hero-content {
		max-width: 820px;
	}

	.page-title {
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 1.25rem;
	}

	.page-subhead {
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0;
	}

	.contact-layout {
		display: grid;
		grid-template-columns: 1.8fr 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	@media (max-width: 980px) {
		.contact-layout {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	.form-container {
		background: var(--bg-surface-card);
		border: 1px solid var(--border-gold);
		border-radius: var(--radius-md);
		padding: 3rem;
		box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8);
	}

	@media (max-width: 640px) {
		.form-container {
			padding: 1.5rem;
		}
	}

	.form-heading {
		font-size: 1.65rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.form-subtext {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0 0 2rem;
	}

	.main-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-grid-2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	@media (max-width: 640px) {
		.form-grid-2 {
			grid-template-columns: 1fr;
		}
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.form-group label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-gold);
		font-weight: 600;
	}

	.form-group input, .form-group select, .form-group textarea {
		background: #06080E;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		padding: 0.85rem 1rem;
		color: var(--text-main);
		font-size: 0.92rem;
		font-family: inherit;
		transition: border-color 0.2s ease;
	}

	.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
		outline: none;
		border-color: var(--accent-gold);
	}

	.scope-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	@media (max-width: 640px) {
		.scope-grid {
			grid-template-columns: 1fr;
		}
	}

	.scope-box {
		background: #06080E;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		padding: 0.75rem;
		font-size: 0.82rem;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		user-select: none;
	}

	.scope-box input[type="checkbox"] {
		accent-color: var(--accent-gold);
	}

	.scope-box:hover {
		border-color: var(--border-light);
		color: var(--text-main);
	}

	.form-submit-row {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.btn-form-submit {
		padding: 1rem;
		font-size: 1rem;
		width: 100%;
	}

	.submit-disclaimer {
		font-size: 0.78rem;
		color: var(--text-subdued);
		text-align: center;
		margin: 0;
	}

	/* Sidebar */
	.sidebar-card {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: sticky;
		top: 100px;
	}

	.sidebar-heading {
		font-size: 1.35rem;
		font-weight: 700;
		margin: 0;
	}

	.sidebar-p {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
	}

	.contact-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border-top: 1px solid var(--border-subtle);
		padding-top: 1rem;
	}

	.c-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-subdued);
	}

	.c-val {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-main);
	}

	.c-val-gold {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.c-role {
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.c-linkedin {
		font-size: 0.82rem;
		color: var(--accent-gold);
		margin-top: 0.2rem;
	}

	.c-sub {
		font-size: 0.78rem;
		color: var(--text-muted);
	}
</style>
