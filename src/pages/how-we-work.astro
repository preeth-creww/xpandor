---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL } from '../consts';
---

<BaseLayout
	title="How Xpandor Works | The Turnkey Retail Operating Model"
	description="One client. One expansion team. One master contract. Discover the operational lifecycle behind physical retail expansion across South India."
>
	<!-- Hero Section: Architectural Drafting Frame -->
	<section class="page-hero">
		<div class="container">
			<div class="hero-drafting-frame architectural-frame">
				<!-- Top Datum Bar -->
				<div class="datum-bar">
					<div class="datum-left">
						<span class="datum-tag">GOVERNANCE SPECIFICATION</span>
						<span class="datum-sep">/</span>
						<span class="datum-text">THE TURNKEY OPERATING MODEL</span>
					</div>
					<div class="datum-right">
						<span class="datum-coord">SINGLE MASTER ACCOUNTABILITY</span>
					</div>
				</div>

				<div class="hero-body">
					<div class="hero-eyebrow-wrap">
						<span class="eyebrow">Operating Architecture</span>
					</div>

					<h1 class="page-title">
						One client. One expansion team. <br class="hidden-sm" />
						<span class="text-gradient-brass">One master contract.</span>
					</h1>

					<p class="page-subhead">
						We replace the costly friction of coordinating seven disparate vendors with a single accountable expansion partner. Here is how Xpandor structures the journey from brand strategy to trading doors.
					</p>

					<div class="hero-actions">
						<a 
							href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20an%20expansion%20plan%20with%20Xpandor.`}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-gold"
						>
							<span>DISCUSS YOUR PLANS WITH US ↗</span>
						</a>
						<a href="#who-owns-what" class="btn btn-outline">
							<span>Review Responsibility Matrix ↓</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- The 7 Steps: Structured Architectural Sequence -->
	<section class="section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Milestone Sequence</span>
				<h2 class="section-title">The operational lifecycle.</h2>
				<p class="section-desc">
					Each phase builds systematically on the preceding one, protecting your capital and ensuring zero communication gaps between trades.
				</p>
			</div>

			<div class="lifecycle-list">
				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">01</span>
						<span class="life-tag">STRATEGY</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Define the Expansion Brief</h3>
						<p class="life-desc">
							We formalize your brand's operational criteria: target customer demographics, unit economics, footfall thresholds, carpet-to-super-built efficiency, electrical load clearances, and regional growth roadmap.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">02</span>
						<span class="life-tag">SITING</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Micro-Market Siting Grid</h3>
						<p class="life-desc">
							We survey micro-markets across Bengaluru and South India, analyzing catchment spending power, competitor trading density, footfall patterns, and road visibility to build a targeted search grid.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">03</span>
						<span class="life-tag">COMMERCIAL</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Lease Negotiation & Closure</h3>
						<p class="life-desc">
							We engage building owners directly, audit structural & MEP parameters, negotiate commercial lease terms, lock in rent-free fit-out periods (45–75 days), and guide transaction closure.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">04</span>
						<span class="life-tag">ENGINEERING</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Technical CAD & Material Detailing</h3>
						<p class="life-desc">
							We translate your concept renders into buildable CAD sets, detailed material schedules, joinery specifications, and landlord fit-out clearances.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">05</span>
						<span class="life-tag">CONSTRUCTION</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Turnkey Civil & Joinery Execution</h3>
						<p class="life-desc">
							Civil masonry, electrical distributions, false ceilings, lighting lines, and custom display joinery are executed under continuous site supervision and tracked against regular milestone programmes.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">06</span>
						<span class="life-tag">FACADE & TEAM</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">Facade Signage & Team Induction</h3>
						<p class="life-desc">
							Storefront facades and 3D illuminated channel letters are erected in parallel with interior finishing, while retail staff recruitment is synchronized for launch readiness.
						</p>
					</div>
				</div>

				<div class="life-step architectural-frame">
					<div class="life-header">
						<span class="life-num">07</span>
						<span class="life-tag">HANDOVER</span>
					</div>
					<div class="life-content">
						<h3 class="life-title">QA/QC Audit & Trading Doors</h3>
						<p class="life-desc">
							Rigorous line-by-line inspection of joinery reveals, paint surfaces, electrical circuits, and snag list clearance. You receive the keys to an inspected, operational store ready to trade.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Who Owns What: Responsibility Matrix -->
	<section id="who-owns-what" class="section ownership-section">
		<div class="container">
			<div class="section-header">
				<span class="eyebrow">Governance & Accountability</span>
				<h2 class="section-title">Who owns what during your rollout.</h2>
				<p class="section-desc">
					Clear boundaries ensure zero confusion and guaranteed execution speed.
				</p>
			</div>

			<div class="table-frame architectural-frame">
				<table class="ownership-table">
					<thead>
						<tr>
							<th>FUNCTION / SCOPE</th>
							<th>CLIENT BRAND</th>
							<th>XPANDOR EXPANSION TEAM</th>
							<th>SPECIALIST TRADES</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="function-cell">Brand Concept & Store Strategy</td>
							<td><span class="status-tag status-rec">OWNS</span> Defines guidelines & brief</td>
							<td>Translates to site CAD drawings</td>
							<td class="text-subdued">—</td>
						</tr>
						<tr>
							<td class="function-cell">Location Sourcing & Siting</td>
							<td>Approves shortlist</td>
							<td><span class="status-tag status-rec">OWNS</span> Search, footfall audit & survey</td>
							<td class="text-subdued">—</td>
						</tr>
						<tr>
							<td class="function-cell">Lease Negotiation & Commercials</td>
							<td>Signs master lease agreement</td>
							<td><span class="status-tag status-rec">OWNS</span> Rent-free grace, NOCs & terms</td>
							<td class="text-subdued">—</td>
						</tr>
						<tr>
							<td class="function-cell">BOQ & Cost Governance</td>
							<td>Approves fixed budget</td>
							<td><span class="status-tag status-rec">OWNS</span> Itemized BOQ & budget governance</td>
							<td class="text-subdued">—</td>
						</tr>
						<tr>
							<td class="function-cell">Civil, MEP & Fit-Out Execution</td>
							<td>Weekly progress review</td>
							<td><span class="status-tag status-rec">OWNS</span> Project management & QA/QC</td>
							<td>Executes under Xpandor supervision</td>
						</tr>
						<tr>
							<td class="function-cell">Facades & 3D Signage Fabrication</td>
							<td>Signs off visual artwork</td>
							<td><span class="status-tag status-rec">OWNS</span> Engineering, permits & mounting</td>
							<td>Fabricates to Xpandor drawings</td>
						</tr>
						<tr>
							<td class="function-cell">Store Launch Workforce</td>
							<td>Conducts final interviews</td>
							<td><span class="status-tag status-rec">OWNS</span> Sourcing, screening & induction</td>
							<td class="text-subdued">—</td>
						</tr>
						<tr>
							<td class="function-cell">Snag List Clearance & Handover</td>
							<td>Final site walkthrough</td>
							<td><span class="status-tag status-rec">OWNS</span> Complete snag audit & handover</td>
							<td>Rectifies under warranty</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section">
		<div class="container text-center">
			<div class="cta-banner architectural-frame mx-auto">
				<span class="eyebrow">Unified Execution</span>
				<h2 class="cta-title">Ready to structure your South India expansion?</h2>
				<p class="cta-desc">
					Whether you are planning one flagship or ten stores across Bengaluru, we will structure the operational roadmap and timeline.
				</p>
				<div class="cta-actions">
					<button type="button" class="btn btn-gold" data-open-modal>
						<span>SUBMIT YOUR DETAILED BRIEF ↗</span>
					</button>
					<a 
						href={`${WHATSAPP_BASE_URL}?text=Hi,%20I'd%20like%20to%20discuss%20an%20expansion%20plan%20with%20Xpandor.`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline"
					>
						<span>DISCUSS YOUR PLANS WITH US ↗</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 3rem;
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 2.5rem 0 2rem;
		}
	}

	.hero-drafting-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow: hidden;
	}

	.datum-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border-subtle);
		background: rgba(11, 13, 19, 0.6);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 768px) {
		.datum-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
			padding: 0.75rem 1.25rem;
		}
	}

	.datum-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.datum-tag {
		color: var(--accent-gold);
		font-weight: 700;
	}

	.datum-sep {
		color: var(--text-subdued);
	}

	.datum-text {
		color: var(--text-muted);
	}

	.datum-coord {
		color: var(--text-subdued);
	}

	.hero-body {
		padding: 4rem 3.5rem;
		max-width: 900px;
	}

	@media (max-width: 768px) {
		.hero-body {
			padding: 2.5rem 1.5rem;
		}
	}

	.hero-eyebrow-wrap {
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: clamp(2.3rem, 4.8vw, 3.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin: 0.6rem 0 1.25rem;
		color: var(--text-main);
	}

	.page-subhead {
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2.25rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	/* Lifecycle List */
	.lifecycle-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.life-step {
		background: var(--bg-surface);
		padding: 2rem 2.5rem;
		border-radius: var(--radius-xs);
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 2rem;
		align-items: baseline;
	}

	@media (max-width: 768px) {
		.life-step {
			grid-template-columns: 1fr;
			gap: 0.85rem;
			padding: 1.5rem 1.25rem;
		}
	}

	.life-header {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.life-num {
		font-family: var(--font-mono);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.life-tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--text-subdued);
	}

	.life-title {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0 0 0.6rem;
		color: var(--text-main);
	}

	.life-desc {
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--text-muted);
		margin: 0;
	}

	/* Ownership Table */
	.ownership-section {
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
		background: #090B10;
	}

	.table-frame {
		background: var(--bg-surface);
		border-radius: var(--radius-xs);
		overflow-x: auto;
		margin-top: 2.5rem;
	}

	.ownership-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		text-align: left;
		min-width: 800px;
	}

	.ownership-table th {
		padding: 1.2rem 1.5rem;
		background: rgba(11, 13, 19, 0.7);
		border-bottom: 1px solid var(--border-subtle);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--accent-gold);
		font-weight: 600;
	}

	.ownership-table td {
		padding: 1.2rem 1.5rem;
		border-bottom: 1px solid var(--border-subtle);
		color: var(--text-muted);
		line-height: 1.55;
	}

	.ownership-table tr:last-child td {
		border-bottom: none;
	}

	.function-cell {
		font-weight: 600;
		color: var(--text-main) !important;
		font-family: var(--font-display);
		width: 240px;
	}

	.status-tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		padding: 0.2rem 0.5rem;
		border-radius: 2px;
		background: var(--bg-stone-muted);
		color: var(--text-muted);
		margin-right: 0.35rem;
	}

	.status-rec {
		background: var(--accent-gold-subtle);
		color: var(--accent-gold);
		border: 1px solid var(--border-brass);
	}

	/* CTA */
	.cta-banner {
		background: var(--bg-surface);
		padding: 4.5rem 3rem;
		border-radius: var(--radius-xs);
		max-width: 800px;
	}

	@media (max-width: 640px) {
		.cta-banner {
			padding: 2.5rem 1.5rem;
		}
	}

	.cta-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 600;
		line-height: 1.15;
		margin: 0.75rem 0 1rem;
		color: var(--text-main);
	}

	.cta-desc {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto 2.25rem;
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}
</style>
